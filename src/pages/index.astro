---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import LandingTab from '../components/LandingTab.astro';
import CatalogTab from '../components/CatalogTab.astro';
import CheckoutTab from '../components/CheckoutTab.astro';
import ProductModal from '../components/ProductModal.astro';
import { products, storeInfo } from '../data/products';
import PaymentBadges from '../components/PaymentBadges.astro';
---

<Layout
	title="ElectroNova | Showroom Oficial de Equipos Electrónicos 2026"
	description="Showroom oficial especializado en laptops OLED 4K, smartphones de titanio, audio de estudio ANC y periféricos de alta gama con chips de 3nm. Despacho express y 2 años de garantía."
>
	<!-- Menú Superior Estilo BandWerk (Negro, Blanco y Acentos Naranja) -->
	<Navbar />

	<!-- Contenedor Principal de las Pestañas -->
	<main class="pb-20">
		<!-- Pestaña 1: Showroom (Landing) -->
		<LandingTab />

		<!-- Pestaña 2: Catálogo e Información Técnica -->
		<CatalogTab />

		<!-- Pestaña 3: Pasarela de Pago (Solo mostrada al iniciar el proceso de compra ficticio) -->
		<CheckoutTab />
	</main>

	<!-- Modal de Información Completa de cada Card -->
	<ProductModal />

	<!-- Toast Flotante de Notificación con Animación GSAP -->
	<div
		id="toast-notification"
		role="status"
		aria-live="polite"
		class="pointer-events-none fixed bottom-6 right-6 z-50 flex translate-y-4 items-center gap-3 rounded-xl border border-white/15 bg-[#0a0a0e] px-4 py-3 text-xs font-medium text-white opacity-0"
	>
		<span id="toast-icon-badge" class="flex h-5 w-5 items-center justify-center rounded-full bg-[#ff5500] text-[10px] font-semibold text-white">✓</span>
		<span id="toast-message">Equipo añadido a la bolsa</span>
	</div>

	<!-- Pie de página minimalista -->
	<footer class="border-t border-white/10 bg-[#050507] py-14 text-stone-400">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-10">
			<div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-12">
				<!-- Logo y Manifiesto de la Marca -->
				<div class="lg:col-span-5 space-y-4">
					<img
						src="/images/logo-electronova.svg"
						alt="ElectroNova Hardware Labs"
						class="h-9 w-auto object-contain"
					/>
					<p class="text-xs text-stone-400 leading-relaxed max-w-sm">
						{storeInfo.description}
					</p>
					<div class="flex items-center gap-2.5 text-xs text-stone-400">
						<span class="inline-flex items-center gap-1.5 font-medium text-stone-200">
							<span class="h-1.5 w-1.5 rounded-full bg-[#ff5500]"></span>
							Showroom abierto
						</span>
						<span aria-hidden="true">·</span>
						<span>San Borja, Lima</span>
					</div>

					<div class="pt-1">
						<PaymentBadges variant="hero" showInstallments={false} />
					</div>
				</div>

				<!-- Navegación en el Footer -->
				<div class="lg:col-span-3 space-y-3">
					<h4 class="text-xs font-semibold uppercase tracking-wider text-stone-200">Navegación</h4>
					<ul class="space-y-2 text-xs">
						<li>
							<button type="button" data-tab-target="landing" class="cursor-pointer transition hover:text-white">
								Inicio
							</button>
						</li>
						<li>
							<button type="button" data-tab-target="catalogo" class="cursor-pointer transition hover:text-white">
								Catálogo Oficial 2026
							</button>
						</li>
						<li>
							<button type="button" data-scroll-anchor="section-temporada" class="cursor-pointer transition hover:text-white">
								Temporada Black Titanium
							</button>
						</li>
						<li>
							<button type="button" data-scroll-anchor="section-nosotros" class="cursor-pointer transition hover:text-white">
								Nosotros y Laboratorio
							</button>
						</li>
						<li>
							<button type="button" data-scroll-anchor="section-contacto" class="cursor-pointer transition hover:text-white">
								Contacto y Asesoría
							</button>
						</li>
					</ul>
				</div>

				<!-- Garantía y Proceso de Compra -->
				<div class="lg:col-span-4 space-y-3">
					<h4 class="text-xs font-semibold uppercase tracking-wider text-stone-200">Garantía y compra</h4>
					<p class="text-xs text-stone-400 leading-relaxed">
						La pasarela de pago se activa al seleccionar cualquier equipo en el showroom o catálogo. Certificación SSL 256-bit con seguro de transporte.
					</p>
					<div class="pt-1">
						<button
							type="button"
							data-tab-target="checkout"
							class="event-btn-pop cursor-pointer inline-flex items-center gap-2 py-2 text-xs font-medium text-stone-200 transition hover:text-white"
						>
							<span>Ver bolsa e iniciar checkout</span>
							<span aria-hidden="true">→</span>
						</button>
					</div>
				</div>
			</div>

			<!-- Barra de Copyright -->
			<div class="flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-white/10 pt-6 text-xs text-stone-500">
				<p>© 2026 <strong class="font-medium text-stone-300">ElectroNova Showroom S.A.C.</strong> RUC 20608920194 · Lima, Perú.</p>
				<p class="font-mono text-[11px] text-stone-500">Astro · GSAP ScrollTrigger · Lenis · Zustand</p>
			</div>
		</div>
	</footer>

	<!-- Datos serializados de productos para el cliente -->
	<script is:inline define:vars={{ productsData: products }}>
		window.__ELECTRONOVA_PRODUCTS__ = productsData;
	</script>
</Layout>

<script>
	import Lenis from 'lenis';
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { shopStore } from '../store/shopStore';

	// Registrar Plugin de ScrollTrigger con GSAP
	gsap.registerPlugin(ScrollTrigger);

	// ==============================================================
	// 1. INICIALIZACIÓN DE LENIS SMOOTH SCROLL (FLUIDO, SIN LAG)
	// ==============================================================
	const lenis = new Lenis({
		duration: 1.2,
		easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
		smoothWheel: true,
		touchMultiplier: 1.5,
	});

	// Sincronizar Lenis con GSAP ScrollTrigger
	lenis.on('scroll', ScrollTrigger.update);

	gsap.ticker.add((time) => {
		lenis.raf(time * 1000);
	});
	gsap.ticker.lagSmoothing(0);

	(window as any).__lenisInstance = lenis;

	// ==============================================================
	// 2. COREOGRAFÍA HERO ENTRANCE (ESTILO FLAGSHIP LAUNCH)
	// ==============================================================
	function initHeroEntrance() {
		const heroCard = document.querySelector('#tab-landing > div:first-child');
		if (!heroCard) return;

		const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

		tl.fromTo(
			heroCard,
			{ opacity: 0, scale: 0.94, y: 30 },
			{ opacity: 1, scale: 1, y: 0, duration: 0.85 }
		);

		tl.fromTo(
			'#tab-landing h1',
			{ opacity: 0, y: 25 },
			{ opacity: 1, y: 0, duration: 0.7 },
			'-=0.5'
		);

		tl.fromTo(
			'#tab-landing p.max-w-xl',
			{ opacity: 0, y: 15 },
			{ opacity: 1, y: 0, duration: 0.6 },
			'-=0.4'
		);
	}

	// ==============================================================
	// 3.5. INFINITE GSAP CAROUSEL FOR HERO SHOWCASE (20x14 SVG MATRIX MASK)
	// ==============================================================
	let cleanupHeroCarousel: (() => void) | undefined;
	function initHeroCarousel() {
		cleanupHeroCarousel?.();
		const carousel = document.getElementById('hero-carousel');
		const stage = document.getElementById('hero-carousel-stage');
		const matrixMask = document.getElementById('hero-matrix-mask');
		const prevBtn = document.getElementById('hero-carousel-prev');
		const nextBtn = document.getElementById('hero-carousel-next');
		if (!carousel || !stage || !matrixMask) return;

		const slides = gsap.utils.toArray<HTMLElement>('.hero-carousel-slide', stage);
		const matrixCells = gsap.utils.toArray<SVGRectElement>('.hero-matrix-cell', matrixMask);
		if (slides.length <= 1 || matrixCells.length === 0) return;

		const buttons = slides.map((s) => s.querySelector<HTMLElement>('.hero-slide-btn'));
		let activeIdx = 0;
		let activeTransition: gsap.core.Timeline | null = null;
		let autoTimer: gsap.core.Tween | null = null;
		let isPaused = false;
		let prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		const setActiveSlideA11y = (idx: number) => {
			slides.forEach((slide, i) => {
				const isActive = i === idx;
				slide.setAttribute('aria-hidden', isActive ? 'false' : 'true');
				slide.style.pointerEvents = isActive ? 'auto' : 'none';
				slide.style.zIndex = isActive ? '10' : '0';
				if (buttons[i]) {
					buttons[i].setAttribute('tabindex', isActive ? '0' : '-1');
				}
			});
		};

		slides.forEach((slide, idx) => {
			gsap.set(slide, { autoAlpha: idx === 0 ? 1 : 0 });
		});
		gsap.set(matrixCells, { opacity: 1 });
		setActiveSlideA11y(0);

		const scheduleNext = () => {
			autoTimer?.kill();
			if (prefersReducedMotion || isPaused) return;
			autoTimer = gsap.delayedCall(3.2, () => {
				goToSlide((activeIdx + 1) % slides.length);
			});
		};

		const goToSlide = (targetIdx: number) => {
			if (targetIdx === activeIdx) return;
			autoTimer?.kill();

			if (prefersReducedMotion) {
				gsap.set(slides[activeIdx], { autoAlpha: 0 });
				gsap.set(slides[targetIdx], { autoAlpha: 1 });
				gsap.set(matrixCells, { opacity: 1 });
				activeIdx = targetIdx;
				setActiveSlideA11y(activeIdx);
				return;
			}

			if (activeTransition?.isActive()) {
				activeTransition.kill();
				slides.forEach((slide, i) => {
					gsap.set(slide, { autoAlpha: i === activeIdx ? 1 : 0 });
				});
			}

			const currentIdx = activeIdx;
			activeIdx = targetIdx;

			const tl = gsap.timeline({
				onComplete: () => {
					activeTransition = null;
					scheduleNext();
				},
			});
			activeTransition = tl;

			// 1. Small matrix mask squares turn transparent (opacity 1 -> 0), revealing the exact section background
			tl.to(matrixCells, {
				opacity: 0,
				duration: 0.14,
				ease: 'none',
				stagger: { amount: 0.34, grid: [14, 20], from: 'random' },
			});

			// 2. Swap active slide in-place while 100% masked out (transparent)
			tl.call(() => setActiveSlideA11y(targetIdx), [], 0.48);
			tl.set(slides[currentIdx], { autoAlpha: 0 }, 0.48);
			tl.set(slides[targetIdx], { autoAlpha: 1 }, 0.48);

			// 3. Small matrix mask squares turn opaque (opacity 0 -> 1) to reveal 100% of the next slide
			tl.to(
				matrixCells,
				{
					opacity: 1,
					duration: 0.16,
					ease: 'none',
					stagger: { amount: 0.36, grid: [14, 20], from: 'random' },
				},
				0.5
			);
		};

		const handlePrev = () => {
			goToSlide((activeIdx - 1 + slides.length) % slides.length);
		};
		const handleNext = () => {
			goToSlide((activeIdx + 1) % slides.length);
		};

		const pause = () => {
			isPaused = true;
			autoTimer?.pause();
		};
		const resume = () => {
			if (!carousel.matches(':hover') && !carousel.matches(':focus-within')) {
				isPaused = false;
				if (autoTimer?.paused()) {
					autoTimer.resume();
				} else if (!activeTransition?.isActive()) {
					scheduleNext();
				}
			}
		};

		prevBtn?.addEventListener('click', handlePrev);
		nextBtn?.addEventListener('click', handleNext);
		carousel.addEventListener('pointerenter', pause);
		carousel.addEventListener('pointerleave', resume);
		carousel.addEventListener('focusin', pause);
		carousel.addEventListener('focusout', resume);

		scheduleNext();

		const cleanup = () => {
			autoTimer?.kill();
			activeTransition?.kill();
			prevBtn?.removeEventListener('click', handlePrev);
			nextBtn?.removeEventListener('click', handleNext);
			carousel.removeEventListener('pointerenter', pause);
			carousel.removeEventListener('pointerleave', resume);
			carousel.removeEventListener('focusin', pause);
			carousel.removeEventListener('focusout', resume);
			document.removeEventListener('astro:before-swap', cleanup);
		};
		cleanupHeroCarousel = cleanup;
		document.addEventListener('astro:before-swap', cleanup, { once: true });
	}

	// ==============================================================
	// 4. PARALLAX EN IMÁGENES SINCRONIZADO CON LENIS SCROLL
	// ==============================================================
	function initParallaxEffects() {

		gsap.utils.toArray<HTMLElement>('.milestone-parallax-img').forEach((img) => {
			gsap.fromTo(
				img,
				{ scale: 1.14, yPercent: -4 },
				{
					scale: 1,
					yPercent: 4,
					ease: 'none',
					scrollTrigger: {
						trigger: img,
						start: 'top bottom',
						end: 'bottom top',
						scrub: 1,
					},
				}
			);
		});
	}

	// ==============================================================
	// 5. TIMELINES DE ENTRADA Y SALIDA VINCULADOS AL SCROLL (GSAP TIMELINE)
	// ==============================================================
	function attachScrollEntranceExitTimeline(el: HTMLElement, animateChildren = false) {
		const innerBlocks = animateChildren ? (Array.from(el.children) as HTMLElement[]) : [];
		const tl = gsap.timeline({
			defaults: { ease: 'power2.out' },
			scrollTrigger: {
				trigger: el,
				start: 'top 92%',
				end: 'bottom 8%',
				scrub: 0.45,
			},
		});

		tl.addLabel('intro', 0);
		tl.addLabel('hold', 0.22);
		tl.addLabel('outro', 0.78);

		tl.fromTo(
			el,
			{ autoAlpha: 0, y: 16 },
			{ autoAlpha: 1, y: 0, duration: 0.22, ease: 'power2.out' },
			'intro'
		);

		if (innerBlocks.length > 1) {
			tl.fromTo(
				innerBlocks,
				{ y: 10 },
				{ y: 0, duration: 0.19, stagger: 0.03, ease: 'power2.out' },
				'intro+=0.03'
			);
		}

		tl.to(
			el,
			{ autoAlpha: 1, y: 0, duration: 0.56, ease: 'none', immediateRender: false },
			'hold'
		);

		tl.to(
			el,
			{ autoAlpha: 0, y: -16, duration: 0.22, ease: 'power2.in', immediateRender: false },
			'outro'
		);

		if (innerBlocks.length > 1) {
			tl.to(
				innerBlocks,
				{ y: -8, duration: 0.22, ease: 'power2.in', immediateRender: false },
				'outro'
			);
		}
	}

	function isElementInVisibleTab(el: HTMLElement): boolean {
		if (el.classList.contains('hidden')) return false;
		const panel = el.closest('.tab-panel');
		return !panel || !panel.classList.contains('hidden');
	}

	let cleanupCardAnimations: (() => void) | undefined;
	function initCardScrollAnimations() {
		cleanupCardAnimations?.();
		const media = gsap.matchMedia();

		media.add(
			{
				canAnimate: '(prefers-reduced-motion: no-preference)',
				reduceMotion: '(prefers-reduced-motion: reduce)',
			},
			(context) => {
				const { canAnimate } = context.conditions as { canAnimate: boolean; reduceMotion: boolean };
				const headers = gsap.utils
					.toArray<HTMLElement>(
						'#section-temporada > div:first-child, #section-destacados > div:first-child, #section-nosotros > div:first-child, #section-contacto > div > div:first-child'
					)
					.filter(isElementInVisibleTab);

				const cards = gsap.utils
					.toArray<HTMLElement>('.seasonal-card, .featured-card, .benefit-card, .catalog-card')
					.filter(isElementInVisibleTab);

				if (!canAnimate) {
					gsap.set([...headers, ...cards], { clearProps: 'opacity,visibility,transform' });
					return;
				}

				headers.forEach((header) => {
					attachScrollEntranceExitTimeline(header, false);
				});

				cards.forEach((card) => {
					const hasStructuredChildren = card.matches('.seasonal-card, .featured-card, .catalog-card');
					attachScrollEntranceExitTimeline(card, hasStructuredChildren);
				});
			}
		);

		const cleanup = () => {
			media.revert();
			document.removeEventListener('astro:before-swap', cleanup);
		};
		cleanupCardAnimations = cleanup;
		document.addEventListener('astro:before-swap', cleanup, { once: true });
	}

	// ==============================================================
	// 6. LECTURA SECUENCIAL DE HITOS EN LA SECCIÓN NOSOTROS (TIMELINE ENTRADA/SALIDA)
	// ==============================================================
	let cleanupStaircaseAnimation: (() => void) | undefined;
	function initNosotrosStaircaseAnimation() {
		cleanupStaircaseAnimation?.();
		const steps = gsap.utils.toArray<HTMLElement>('.staircase-step').filter(isElementInVisibleTab);
		if (steps.length === 0) return;

		const media = gsap.matchMedia();
		media.add(
			{
				canAnimate: '(prefers-reduced-motion: no-preference)',
				reduceMotion: '(prefers-reduced-motion: reduce)',
			},
			(context) => {
				const { canAnimate } = context.conditions as { canAnimate: boolean; reduceMotion: boolean };
				if (!canAnimate) {
					gsap.set(steps, { clearProps: 'opacity,visibility,transform' });
					return;
				}

				steps.forEach((step) => {
					attachScrollEntranceExitTimeline(step, true);
				});
			}
		);

		const cleanup = () => {
			media.revert();
			document.removeEventListener('astro:before-swap', cleanup);
		};
		cleanupStaircaseAnimation = cleanup;
		document.addEventListener('astro:before-swap', cleanup, { once: true });
	}

	// ==============================================================
	// 7. ANIMACIÓN NUMÉRICA (COUNT-UP) CON SCROLLTRIGGER
	// ==============================================================
	function initStatsCounters() {
		const counters = document.querySelectorAll<HTMLElement>('[data-counter-target]');
		counters.forEach((el) => {
			const targetVal = parseFloat(el.getAttribute('data-counter-target') || '0');
			const prefix = el.getAttribute('data-counter-prefix') || '';
			const suffix = el.getAttribute('data-counter-suffix') || '';

			const obj = { val: 0 };
			gsap.to(obj, {
				val: targetVal,
				duration: 1.8,
				ease: 'power2.out',
				scrollTrigger: {
					trigger: el,
					start: 'top 90%',
					toggleActions: 'play none none none',
				},
				onUpdate: () => {
					el.textContent = `${prefix}${Math.round(obj.val).toLocaleString()}${suffix}`;
				},
			});
		});
	}

	// ==============================================================
	// 8. ANIMACIÓN: SKILLS SCROLL TIMELINE & SCROLL REACT
	// ==============================================================
	let cleanupSkillsTimeline: (() => void) | undefined;
	function initSkillsScrollTimeline() {
		cleanupSkillsTimeline?.();
		const section = document.getElementById('skills-timeline-section');
		if (!section) return;

		const media = gsap.matchMedia();
		media.add('(prefers-reduced-motion: no-preference)', () => {
			const tree = section.querySelector<HTMLElement>('[data-skills-tree]');
			const progress = section.querySelector<HTMLElement>('#skills-timeline-progress');
			if (tree && progress) {
				gsap.fromTo(progress, { scaleY: 0 }, {
					scaleY: 1,
					ease: 'none',
					scrollTrigger: { trigger: tree, start: 'top 75%', end: 'bottom 65%', scrub: 0.4 },
				});
			}
			section.querySelectorAll<HTMLElement>('.skill-timeline-item').forEach((item) => {
				const branch = item.querySelector<HTMLElement>('.skill-branch');
				const dot = item.querySelector<HTMLElement>('.skill-timeline-dot');
				const reveal = gsap.timeline({
					scrollTrigger: { trigger: item, start: 'top 80%', once: true },
					defaults: { duration: 0.45, ease: 'power2.out' },
				});
				if (branch) reveal.fromTo(branch, { opacity: 0, y: 10 }, { opacity: 1, y: 0, clearProps: 'opacity,transform' });
				if (dot) reveal.to(dot, { borderColor: '#ff5500', color: '#ff5500' }, 0);
			});
		}, section);

		// Restore original styles and remove scoped triggers before page navigation.
		const cleanup = () => {
			media.revert();
			document.removeEventListener('astro:before-swap', cleanup);
		};
		cleanupSkillsTimeline = cleanup;
		document.addEventListener('astro:before-swap', cleanup, { once: true });
	}

	// Ejecutar inicializaciones de animación al cargar
	initHeroEntrance();
	initHeroCarousel();
	initParallaxEffects();
	initCardScrollAnimations();
	initNosotrosStaircaseAnimation();
	initSkillsScrollTimeline();
	initStatsCounters();

	// ==============================================================
	// 9. FUNCIÓN TOAST DE VALIDACIÓN CON GSAP
	// ==============================================================
	function showToast(msg: string, isError = false) {
		const toast = document.getElementById('toast-notification');
		const text = document.getElementById('toast-message');
		const badge = document.getElementById('toast-icon-badge');
		if (!toast || !text) return;

		text.textContent = msg;
		if (badge) {
			badge.textContent = isError ? '✕' : '✓';
			badge.className = isError
				? 'flex h-5 w-5 items-center justify-center rounded-full bg-rose-500 text-[10px] font-semibold text-white'
				: 'flex h-5 w-5 items-center justify-center rounded-full bg-[#ff5500] text-[10px] font-semibold text-white';
		}

		gsap.killTweensOf(toast);
		gsap.fromTo(
			toast,
			{ opacity: 0, y: 10 },
			{
				opacity: 1,
				y: 0,
				duration: 0.25,
				ease: 'power2.out',
				onComplete: () => {
					gsap.to(toast, { opacity: 0, y: 8, delay: 2.4, duration: 0.25, ease: 'power2.in' });
				},
			}
		);
	}

	// ==============================================================
	// 10. NAVEGACIÓN ENTRE PESTAÑAS CON GSAP Y LENIS
	// ==============================================================
	function switchTab(tabName: 'landing' | 'catalogo' | 'checkout', onCompleteCallback?: () => void) {
		const activeModalEl = document.getElementById('product-info-modal');
		if (activeModalEl && !activeModalEl.classList.contains('hidden')) {
			closeProductModal();
		}
		shopStore.getState().setActiveTab(tabName);

		const panels: Record<string, HTMLElement | null> = {
			landing: document.getElementById('tab-landing'),
			catalogo: document.getElementById('tab-catalogo'),
			checkout: document.getElementById('tab-checkout'),
		};

		if (!onCompleteCallback) {
			lenis.scrollTo(0, { immediate: true });
			window.scrollTo({ top: 0, behavior: 'instant' as ScrollBehavior });
		}

		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		Object.entries(panels).forEach(([key, panel]) => {
			if (!panel) return;
			if (key === tabName) {
				panel.classList.remove('hidden');
				const childBlocks = Array.from(panel.children) as HTMLElement[];
				gsap.killTweensOf([panel, ...childBlocks]);

				const finalizeTabSwitch = () => {
					gsap.set([panel, ...childBlocks], { clearProps: 'opacity,visibility,transform' });
					initCardScrollAnimations();
					initNosotrosStaircaseAnimation();
					ScrollTrigger.refresh();
					if (onCompleteCallback) onCompleteCallback();
				};

				if (reduceMotion) {
					finalizeTabSwitch();
					return;
				}

				const tabTl = gsap.timeline({
					defaults: { ease: 'expo.out' },
					onComplete: finalizeTabSwitch,
				});

				tabTl.fromTo(
					panel,
					{ autoAlpha: 0, y: 72 },
					{
						autoAlpha: 1,
						y: 0,
						duration: 0.65,
						ease: 'expo.out',
					},
					0
				);

				if (childBlocks.length > 0) {
					tabTl.fromTo(
						childBlocks,
						{ autoAlpha: 0, y: 48 },
						{
							autoAlpha: 1,
							y: 0,
							duration: 0.56,
							stagger: 0.055,
							ease: 'power3.out',
						},
						0.08
					);
				}
			} else {
				panel.classList.add('hidden');
			}
		});

		document.querySelectorAll<HTMLElement>('.nav-tab-btn').forEach((btn) => {
			const target = btn.getAttribute('data-tab-target');
			const active = target === tabName || (!target && tabName === 'catalogo');
			btn.classList.toggle('active-tab', active);
			if (active) btn.setAttribute('aria-current', 'page');
			else btn.removeAttribute('aria-current');
		});
	}

	document.querySelectorAll<HTMLElement>('[data-tab-target]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const target = btn.getAttribute('data-tab-target') as 'landing' | 'catalogo' | 'checkout';
			if (target) switchTab(target);
		});
	});

	document.querySelectorAll<HTMLElement>('[data-scroll-anchor]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const anchorId = btn.getAttribute('data-scroll-anchor');
			if (!anchorId) return;

			const currentTab = shopStore.getState().activeTab;
			if (currentTab !== 'landing') {
				switchTab('landing', () => {
					setTimeout(() => {
						const targetEl = document.getElementById(anchorId);
						if (targetEl) {
							lenis.scrollTo(targetEl, { offset: -90, duration: 1.2 });
						}
					}, 100);
				});
			} else {
				const targetEl = document.getElementById(anchorId);
				if (targetEl) {
					lenis.scrollTo(targetEl, { offset: -90, duration: 1.2 });
				}
			}
		});
	});

	document.querySelectorAll<HTMLElement>('[data-jump-category]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const cat = btn.getAttribute('data-jump-category') || 'Todos';
			switchTab('catalogo', () => {
				applyCatalogFilter(cat, '');
			});
		});
	});

	// Filtros y Buscador del Catálogo
	const searchInput = document.getElementById('catalog-search') as HTMLInputElement | null;

	function applyCatalogFilter(category: string, query: string) {
		shopStore.getState().setCategory(category);
		shopStore.getState().setSearchQuery(query);
		const normalizedQuery = query.trim().toLowerCase();

		document.querySelectorAll<HTMLElement>('.cat-filter-btn').forEach((btn) => {
			const active = btn.getAttribute('data-filter-cat') === category;
			btn.classList.toggle('is-active', active);
			btn.setAttribute('aria-pressed', String(active));
		});

		let visibleCount = 0;
		const visibleCards: HTMLElement[] = [];

		document.querySelectorAll<HTMLElement>('.catalog-card').forEach((card) => {
			const cardCat = card.getAttribute('data-card-category') || '';
			const cardName = card.getAttribute('data-card-name') || '';

			const matchesCat = category === 'Todos' || cardCat === category;
			const matchesSearch = !normalizedQuery || cardName.includes(normalizedQuery);

			if (matchesCat && matchesSearch) {
				card.classList.remove('hidden');
				visibleCount++;
				visibleCards.push(card);
			} else {
				card.classList.add('hidden');
			}
		});

		const countEl = document.getElementById('catalog-count');
		if (countEl) countEl.textContent = String(visibleCount);

		initCardScrollAnimations();
		ScrollTrigger.refresh();

		if (visibleCards.length > 0) {
			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			if (!reduceMotion) {
				gsap.fromTo(
					visibleCards,
					{ autoAlpha: 0, y: 8 },
					{
						autoAlpha: 1,
						y: 0,
						duration: 0.35,
						stagger: 0.03,
						ease: 'power2.out',
					}
				);
			} else {
				gsap.set(visibleCards, { clearProps: 'opacity,visibility,transform' });
			}
		}
	}

	document.querySelectorAll<HTMLElement>('.cat-filter-btn').forEach((btn) => {
		btn.addEventListener('click', () => {
			const cat = btn.getAttribute('data-filter-cat') || 'Todos';
			applyCatalogFilter(cat, searchInput?.value || '');
		});
	});

	searchInput?.addEventListener('input', () => {
		const currentCat = shopStore.getState().currentCategory;
		applyCatalogFilter(currentCat, searchInput.value);
	});

	// Modal de Producto
	const modal = document.getElementById('product-info-modal');
	const modalDialog = document.getElementById('modal-dialog');
	let lastModalTrigger: HTMLElement | null = null;

	function openProductModal(productId: string, triggerEl?: HTMLElement | null) {
		const products = shopStore.getState().products;
		const product = products.find((p) => p.id === productId);
		if (!product || !modal || !modalDialog) return;

		lastModalTrigger = triggerEl || (document.activeElement instanceof HTMLElement ? document.activeElement : null);
		shopStore.getState().openModal(product.id);

		const imgEl = document.getElementById('modal-img') as HTMLImageElement | null;
		const badgeEl = document.getElementById('modal-badge');
		const catEl = document.getElementById('modal-category');
		const skuEl = document.getElementById('modal-sku');
		const ratingEl = document.getElementById('modal-rating');
		const titleEl = document.getElementById('modal-title');
		const priceEl = document.getElementById('modal-price');
		const oldPriceEl = document.getElementById('modal-old-price');
		const stockEl = document.getElementById('modal-stock');
		const descEl = document.getElementById('modal-description');
		const warrantyEl = document.getElementById('modal-warranty');
		const highlightsEl = document.getElementById('modal-highlights');
		const specsEl = document.getElementById('modal-specs');

		if (imgEl) {
			imgEl.src = product.image;
			imgEl.alt = product.name;
		}
		if (badgeEl) badgeEl.textContent = product.badge || product.category;
		if (catEl) catEl.textContent = product.category;
		if (skuEl) skuEl.textContent = `SKU: ${product.sku}`;
		if (ratingEl) ratingEl.textContent = `★ ${product.rating} (${product.reviews} reseñas)`;
		if (titleEl) titleEl.textContent = product.name;
		if (priceEl) priceEl.textContent = `$${product.price.toLocaleString()}`;
		if (oldPriceEl) oldPriceEl.textContent = product.oldPrice ? `$${product.oldPrice.toLocaleString()}` : '';
		if (stockEl) stockEl.textContent = `En stock (${product.stock} disponibles)`;
		if (descEl) descEl.textContent = product.description;
		if (warrantyEl) warrantyEl.textContent = product.warranty;

		if (highlightsEl) {
			highlightsEl.innerHTML = product.highlights
				.map(
					(h) =>
						`<li class="flex items-start gap-2"><span class="text-[#ff5500]" aria-hidden="true">·</span><span>${h}</span></li>`
				)
				.join('');
		}

		if (specsEl) {
			specsEl.innerHTML = product.specs
				.map(
					(s) => `
					<div class="grid grid-cols-1 sm:grid-cols-3 gap-1 py-2.5 text-xs">
						<span class="font-medium text-stone-400">${s.label}</span>
						<span class="sm:col-span-2 text-stone-200">${s.value}</span>
					</div>
				`
				)
				.join('');
		}

		modal.classList.remove('hidden');
		modal.classList.add('block');
		modal.setAttribute('aria-hidden', 'false');
		modal.scrollTop = 0;
		document.body.style.overflow = 'hidden';
		lenis.stop();
		document.getElementById('modal-close-btn')?.focus();

		const backdropEl = document.getElementById('modal-backdrop');
		const headerEl = modalDialog.querySelector<HTMLElement>('header');
		const revealBlocks = gsap.utils.toArray<HTMLElement>(
			'.grid > div > *',
			modalDialog
		);
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		gsap.killTweensOf([backdropEl, modalDialog, headerEl, ...revealBlocks].filter(Boolean));

		if (!reduceMotion) {
			const openTl = gsap.timeline({ defaults: { ease: 'expo.out' } });
			openTl.addLabel('enter', 0);

			if (backdropEl) {
				openTl.fromTo(
					backdropEl,
					{ autoAlpha: 0 },
					{ autoAlpha: 1, duration: 0.38, ease: 'power2.out', clearProps: 'opacity,visibility' },
					'enter'
				);
			}

			openTl.fromTo(
				modalDialog,
				{ yPercent: 100, autoAlpha: 1 },
				{
					yPercent: 0,
					autoAlpha: 1,
					duration: 0.68,
					ease: 'expo.out',
					clearProps: 'opacity,visibility,transform',
				},
				'enter'
			);

			if (headerEl) {
				openTl.fromTo(
					headerEl,
					{ autoAlpha: 0, y: 36 },
					{
						autoAlpha: 1,
						y: 0,
						duration: 0.5,
						ease: 'power3.out',
						clearProps: 'opacity,visibility,transform',
					},
					'enter+=0.14'
				);
			}

			if (revealBlocks.length > 0) {
				openTl.fromTo(
					revealBlocks,
					{ autoAlpha: 0, y: 48 },
					{
						autoAlpha: 1,
						y: 0,
						duration: 0.56,
						stagger: 0.045,
						ease: 'power3.out',
						clearProps: 'opacity,visibility,transform',
					},
					'enter+=0.18'
				);
			}
		} else {
			gsap.set([backdropEl, modalDialog, headerEl, ...revealBlocks].filter(Boolean), {
				clearProps: 'opacity,visibility,transform',
			});
		}
	}

	function closeProductModal() {
		if (!modal || !modalDialog) return;
		shopStore.getState().closeModal();
		modal.setAttribute('aria-hidden', 'true');
		document.body.style.overflow = '';
		lenis.start();

		const backdropEl = document.getElementById('modal-backdrop');
		const headerEl = modalDialog.querySelector<HTMLElement>('header');
		const revealBlocks = gsap.utils.toArray<HTMLElement>(
			'.grid > div > *',
			modalDialog
		);

		const finishClose = () => {
			modal.classList.add('hidden');
			modal.classList.remove('block', 'flex');
			gsap.set([backdropEl, modalDialog, headerEl, ...revealBlocks].filter(Boolean), {
				clearProps: 'opacity,visibility,transform',
			});
			lastModalTrigger?.focus();
			lastModalTrigger = null;
		};

		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (reduceMotion) {
			finishClose();
			return;
		}

		gsap.killTweensOf([backdropEl, modalDialog, headerEl, ...revealBlocks].filter(Boolean));

		const closeTl = gsap.timeline({
			defaults: { ease: 'power3.inOut' },
			onComplete: finishClose,
		});
		closeTl.addLabel('exit', 0);
		closeTl.to(
			modalDialog,
			{ yPercent: 100, duration: 0.46, ease: 'expo.in' },
			'exit'
		);
		if (backdropEl) {
			closeTl.to(backdropEl, { autoAlpha: 0, duration: 0.36, ease: 'power2.in' }, 'exit+=0.08');
		}
	}

	document.querySelectorAll<HTMLElement>('[data-open-modal]').forEach((el) => {
		el.addEventListener('click', () => {
			const id = el.getAttribute('data-open-modal');
			if (id) openProductModal(id, el);
		});
	});

	document.getElementById('modal-close-btn')?.addEventListener('click', closeProductModal);
	document.getElementById('modal-backdrop')?.addEventListener('click', closeProductModal);
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
			closeProductModal();
		}
	});

	// VALIDACIÓN ZUSTAND: Añadir al carrito desde el modal
	document.getElementById('modal-add-cart-btn')?.addEventListener('click', () => {
		const activeId = shopStore.getState().activeModalProductId;
		if (activeId) {
			const res = shopStore.getState().addToCart(activeId);
			showToast(res.message, !res.success);
			if (res.success) closeProductModal();
		}
	});

	document.getElementById('modal-buy-now-btn')?.addEventListener('click', () => {
		const activeId = shopStore.getState().activeModalProductId;
		if (activeId) {
			const res = shopStore.getState().addToCart(activeId);
			if (res.success) {
				closeProductModal();
				switchTab('checkout');
			} else {
				showToast(res.message, true);
			}
		}
	});

	// VALIDACIÓN ZUSTAND: Añadir al carrito desde cualquier botón
	document.querySelectorAll<HTMLElement>('[data-add-cart]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const id = btn.getAttribute('data-add-cart');
			if (id) {
				const res = shopStore.getState().addToCart(id);
				showToast(res.message, !res.success);
			}
		});
	});

	function renderCartFromStore() {
		const state = shopStore.getState();
		const totalCount = state.getTotalItemsCount();
		const finalTotal = state.getTotal();
		const subtotal = state.getSubtotal();
		const discount = state.getDiscount();

		const navBadge = document.getElementById('nav-cart-badge');
		const navTotal = document.getElementById('nav-cart-total');
		if (navBadge) {
			navBadge.textContent = String(totalCount);
		}
		if (navTotal) navTotal.textContent = `$${finalTotal.toLocaleString()}`;

		const itemsContainer = document.getElementById('checkout-cart-items');
		const emptyState = document.getElementById('checkout-empty-state');

		if (itemsContainer && emptyState) {
			if (state.cart.length === 0) {
				itemsContainer.innerHTML = '';
				emptyState.classList.remove('hidden');
			} else {
				emptyState.classList.add('hidden');
				itemsContainer.innerHTML = state.cart
					.map(
						(item) => `
						<div class="flex items-center justify-between gap-3 py-3">
							<img src="${item.product.image}" alt="${item.product.name}" class="h-12 w-12 rounded-xl bg-[#050507] object-cover shrink-0" />
							<div class="min-w-0 flex-1">
								<p class="truncate text-xs font-medium text-white">${item.product.name}</p>
								<p class="text-[11px] text-stone-400">$${item.product.price.toLocaleString()} c/u</p>
							</div>
							<div class="flex items-center gap-1.5">
								<button type="button" data-cart-dec="${item.product.id}" aria-label="Disminuir cantidad de ${item.product.name}" class="event-btn-pop cursor-pointer flex h-6 w-6 items-center justify-center rounded-md border border-white/15 text-xs font-medium text-stone-300 hover:border-white/35 hover:text-white">-</button>
								<span class="w-5 text-center text-xs font-medium text-white">${item.qty}</span>
								<button type="button" data-cart-inc="${item.product.id}" aria-label="Aumentar cantidad de ${item.product.name}" class="event-btn-pop cursor-pointer flex h-6 w-6 items-center justify-center rounded-md border border-white/15 text-xs font-medium text-stone-300 hover:border-white/35 hover:text-white">+</button>
							</div>
						</div>
					`
					)
					.join('');

				itemsContainer.querySelectorAll<HTMLElement>('[data-cart-inc]').forEach((btn) => {
					btn.addEventListener('click', () => {
						const id = btn.getAttribute('data-cart-inc');
						if (id) {
							const res = shopStore.getState().updateQuantity(id, 1);
							if (!res.success && res.message) showToast(res.message, true);
						}
					});
				});

				itemsContainer.querySelectorAll<HTMLElement>('[data-cart-dec]').forEach((btn) => {
					btn.addEventListener('click', () => {
						const id = btn.getAttribute('data-cart-dec');
						if (id) {
							const res = shopStore.getState().updateQuantity(id, -1);
							if (!res.success && res.message) showToast(res.message, true);
						}
					});
				});
			}
		}

		const subEl = document.getElementById('summary-subtotal');
		const discEl = document.getElementById('summary-discount');
		const totEl = document.getElementById('summary-total');

		if (subEl) subEl.textContent = `$${subtotal.toLocaleString()}`;
		if (discEl) discEl.textContent = `-$${discount.toLocaleString()}`;
		if (totEl) totEl.textContent = `$${finalTotal.toLocaleString()}`;
	}

	shopStore.subscribe(() => {
		renderCartFromStore();
	});

	document.getElementById('clear-cart-btn')?.addEventListener('click', () => {
		shopStore.getState().clearCart();
		showToast('Bolsa de compra vaciada');
	});

	document.getElementById('load-demo-cart-btn')?.addEventListener('click', () => {
		shopStore.getState().loadDemoCart();
		showToast('Equipos demo cargados a la bolsa');
	});

	// VALIDACIÓN ZUSTAND: Cupones con Feedback Visual y Chips Rápidos
	function handleApplyCoupon(code: string) {
		const input = document.getElementById('coupon-input') as HTMLInputElement | null;
		const feedback = document.getElementById('coupon-feedback');
		if (!feedback) return;

		if (input) input.value = code;
		const result = shopStore.getState().applyCouponCode(code);
		feedback.classList.remove('hidden');
		feedback.textContent = result.message;
		feedback.className = result.success
			? 'mt-1.5 text-xs font-medium text-stone-200'
			: 'mt-1.5 text-xs font-medium text-rose-400';
		showToast(result.message, !result.success);
	}

	document.getElementById('apply-coupon-btn')?.addEventListener('click', () => {
		const input = document.getElementById('coupon-input') as HTMLInputElement | null;
		if (input) handleApplyCoupon(input.value);
	});

	// Chips rápidos para probar cupones de Zustand
	document.querySelectorAll<HTMLElement>('[data-coupon-quick]').forEach((chip) => {
		chip.addEventListener('click', () => {
			const code = chip.getAttribute('data-coupon-quick');
			if (code) handleApplyCoupon(code);
		});
	});

	// Pestañas de Métodos de Pago
	document.querySelectorAll<HTMLElement>('.pay-method-btn').forEach((btn) => {
		btn.addEventListener('click', () => {
			const method = btn.getAttribute('data-pay-method');

			document.querySelectorAll<HTMLElement>('.pay-method-btn').forEach((b) => {
				const active = b.getAttribute('data-pay-method') === method;
				b.classList.toggle('is-active', active);
				b.setAttribute('aria-pressed', String(active));
			});

			document.getElementById('pay-panel-card')?.classList.toggle('hidden', method !== 'card');
			document.getElementById('pay-panel-qr')?.classList.toggle('hidden', method !== 'qr');
			document.getElementById('pay-panel-transfer')?.classList.toggle('hidden', method !== 'transfer');
		});
	});

	// Validación y Auto-formateo en Tiempo Real de Tarjeta de Crédito Ficticia
	const inputCardNum = document.getElementById('input-card-number') as HTMLInputElement | null;
	const inputCardHolder = document.getElementById('input-card-holder') as HTMLInputElement | null;
	const inputCardExp = document.getElementById('input-card-expiry') as HTMLInputElement | null;
	const cardBrandLabel = document.getElementById('card-brand-label');

	inputCardNum?.addEventListener('input', () => {
		const digits = inputCardNum.value.replace(/\D/g, '').slice(0, 16);
		const formatted = digits.replace(/(\d{4})(?=\d)/g, '$1 ');
		inputCardNum.value = formatted;
		const preview = document.getElementById('card-preview-number');
		if (preview) preview.textContent = formatted || '•••• •••• •••• ••••';

		// Detección en vivo de franquicia bancaria
		if (cardBrandLabel) {
			if (digits.startsWith('4')) {
				cardBrandLabel.textContent = 'VISA SIGNATURE';
			} else if (digits.startsWith('5')) {
				cardBrandLabel.textContent = 'MASTERCARD BLACK';
			} else if (digits.startsWith('3')) {
				cardBrandLabel.textContent = 'AMERICAN EXPRESS';
			} else {
				cardBrandLabel.textContent = 'TITANIUM CARD';
			}
		}
	});

	inputCardHolder?.addEventListener('input', () => {
		const preview = document.getElementById('card-preview-holder');
		if (preview) preview.textContent = inputCardHolder.value.toUpperCase() || 'TITULAR';
	});

	inputCardExp?.addEventListener('input', () => {
		let v = inputCardExp.value.replace(/\D/g, '').slice(0, 4);
		if (v.length >= 2) v = v.slice(0, 2) + '/' + v.slice(2);
		inputCardExp.value = v;
		const preview = document.getElementById('card-preview-expiry');
		if (preview) preview.textContent = v || 'MM/AA';
	});

	// VALIDACIÓN ZUSTAND: Procesamiento de Pago y Creación de Orden
	const checkoutForm = document.getElementById('checkout-form') as HTMLFormElement | null;
	const successModal = document.getElementById('payment-success-modal');
	const successCard = document.getElementById('payment-success-card');

	checkoutForm?.addEventListener('submit', (e) => {
		e.preventDefault();

		const buyerName = (document.getElementById('buyer-name') as HTMLInputElement | null)?.value || '';
		const buyerEmail = (document.getElementById('buyer-email') as HTMLInputElement | null)?.value || '';
		const buyerAddress = (document.getElementById('buyer-address') as HTMLInputElement | null)?.value || '';

		const res = shopStore.getState().processCheckout({
			name: buyerName,
			email: buyerEmail,
			address: buyerAddress,
		});

		if (!res.success) {
			showToast(res.message || 'Verifica los datos ingresados', true);
			return;
		}

		const orderEl = document.getElementById('receipt-order-id');
		const buyerEl = document.getElementById('receipt-buyer');
		const totalEl = document.getElementById('receipt-total');

		if (orderEl) orderEl.textContent = res.orderId || '#EN-2026';
		if (buyerEl) buyerEl.textContent = buyerName;
		if (totalEl) totalEl.textContent = `$${(res.total || 0).toLocaleString()}`;

		if (successModal && successCard) {
			successModal.classList.remove('hidden');
			successModal.classList.add('flex');
			gsap.fromTo(
				successCard,
				{ opacity: 0, y: 10 },
				{ opacity: 1, y: 0, duration: 0.35, ease: 'power2.out', clearProps: 'transform' }
			);
		}
	});

	document.getElementById('close-success-btn')?.addEventListener('click', () => {
		if (successModal) {
			successModal.classList.add('hidden');
			successModal.classList.remove('flex');
		}
		switchTab('landing');
	});

	renderCartFromStore();
</script>
