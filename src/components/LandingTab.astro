---
import { products, skills, seasonalOffers, storeInfo } from '../data/products';
import Icon from './icons/Icon.astro';
import PaymentBadges from './PaymentBadges.astro';
import ProductCard from './ProductCard.astro';
import SeasonalOfferCard from './SeasonalOfferCard.astro';

const featuredProducts = products.slice(0, 3);

const heroSlides = [
	{
		id: 'laptop-nova-pro-16',
		title: 'NovaBook Pro 16″',
		spec: 'OLED · Titanium',
		image: '/images/hero-electronics.png',
		alt: 'Laptop y audífonos del ecosistema ElectroNova',
		objectPos: 'object-[52%_50%]',
	},
	{
		id: 'smartphone-titan-x',
		title: 'TitanPhone X Pro Max',
		spec: '200MP · Titanium',
		image: '/images/smartphone-ultra.png',
		alt: 'Smartphone TitanPhone X Pro Max en acabado titanio',
		objectPos: 'object-[50%_38%]',
	},
	{
		id: 'headphones-sonic-anc',
		title: 'SonicPulse Studio ANC',
		spec: 'ANC -48dB · Berilio',
		image: '/images/headphones-anc.png',
		alt: 'Audífonos SonicPulse Studio ANC Pro de alta fidelidad',
		objectPos: 'object-[50%_52%]',
	},
];
---

<section id="tab-landing" class="tab-panel mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8 space-y-24">
	<!-- Open hero; preserve the existing entrance and image animation hooks. -->
	<div class="grid items-center gap-10 py-6 sm:py-10 lg:min-h-[calc(100svh-8rem)] lg:grid-cols-2 lg:gap-16 lg:py-6">
		<div class="space-y-6">
			<div class="flex max-w-xl items-center justify-between gap-4">
				<p class="text-[11px] font-semibold uppercase tracking-[.18em] text-[#ff5500]">ElectroNova · Titanium 2026</p>
				<div class="flex items-center gap-1.5" role="group" aria-label="Controles de equipo destacado">
					<button
						id="hero-carousel-prev"
						type="button"
						aria-label="Equipo anterior"
						class="inline-flex h-7 w-7 cursor-pointer items-center justify-center rounded-full border border-white/10 text-stone-400 transition hover:border-[#ff5500]/50 hover:text-white"
					>
						<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5m0 0l6-6m-6 6l6 6" />
						</svg>
					</button>
					<button
						id="hero-carousel-next"
						type="button"
						aria-label="Siguiente equipo"
						class="inline-flex h-7 w-7 cursor-pointer items-center justify-center rounded-full border border-white/10 text-stone-400 transition hover:border-[#ff5500]/50 hover:text-white"
					>
						<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m0 0l-6-6m6 6l-6 6" />
						</svg>
					</button>
				</div>
			</div>
			<h1 class="max-w-xl text-[clamp(2.5rem,4.5vw,4.25rem)] font-semibold leading-[1.06] tracking-tight text-white">
				Potencia para<br />
				<span class="text-[#ff5500]">ir más lejos.</span>
			</h1>
			<p class="max-w-xl text-sm leading-relaxed text-stone-400 sm:text-base">
				Laptops, audio y tecnología para lo que viene. Diseño preciso, rendimiento sin límites y dos años de garantía.
			</p>
			<div class="flex flex-wrap items-center gap-x-7 gap-y-4 pt-1">
				<button type="button" data-tab-target="catalogo" class="event-btn-pop inline-flex cursor-pointer items-center gap-4 rounded-full bg-white px-6 py-3 text-sm font-semibold text-black transition hover:bg-stone-200">
					Explorar catálogo <span aria-hidden="true">↗</span>
				</button>
				<button type="button" data-scroll-anchor="section-temporada" class="event-btn-pop cursor-pointer py-3 text-sm font-medium text-stone-300 transition hover:text-white">
					Ver temporada <span aria-hidden="true">→</span>
				</button>
			</div>
			<p class="pt-2 text-xs leading-relaxed text-stone-500">Envío asegurado · Hasta 12 cuotas sin interés<br />Visa, Mastercard, Apple Pay y Yape / Plin</p>
		</div>
		<div
			id="hero-carousel"
			class="min-w-0"
			aria-roledescription="carousel"
			aria-label="Equipos destacados ElectroNova"
		>
			<svg class="pointer-events-none absolute h-0 w-0 overflow-hidden" aria-hidden="true">
				<defs>
					<mask id="hero-matrix-mask" maskUnits="objectBoundingBox" maskContentUnits="objectBoundingBox">
						{Array.from({ length: 14 }).map((_, row) =>
							Array.from({ length: 20 }).map((__, col) => (
								<rect
									class="hero-matrix-cell"
									x={(col / 20 - 0.0015).toFixed(5)}
									y={(row / 14 - 0.0015).toFixed(5)}
									width={(1 / 20 + 0.003).toFixed(5)}
									height={(1 / 14 + 0.003).toFixed(5)}
									fill="#ffffff"
								/>
							))
						)}
					</mask>
				</defs>
			</svg>
			<div
				id="hero-carousel-stage"
				class="relative grid grid-cols-1 grid-rows-1 items-center"
				style="-webkit-mask: url(#hero-matrix-mask); mask: url(#hero-matrix-mask);"
			>
				{heroSlides.map((slide, index) => (
					<figure
						class:list={[
							'hero-carousel-slide col-start-1 row-start-1 min-w-0 w-full',
							index === 0 ? 'z-10 opacity-100' : 'z-0 opacity-0 pointer-events-none',
						]}
						aria-hidden={index === 0 ? 'false' : 'true'}
					>
						<div
							class="relative mx-auto aspect-[4/3] max-h-[min(48svh,440px)] w-full overflow-hidden"
							style="-webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 48%, rgba(0,0,0,0.68) 72%, rgba(0,0,0,0.18) 89%, transparent 100%); mask-image: linear-gradient(to bottom, #000 0%, #000 48%, rgba(0,0,0,0.68) 72%, rgba(0,0,0,0.18) 89%, transparent 100%);"
						>
							<img
								src={slide.image}
								alt={slide.alt}
								fetchpriority={index === 0 ? 'high' : 'low'}
								class:list={[
									'hero-carousel-img block h-full w-full object-cover',
									slide.objectPos,
								]}
							/>
						</div>
						<figcaption class="relative mt-5 flex flex-wrap items-center justify-between gap-3 text-xs">
							<span class="text-stone-400">
								{slide.title} <span class="ml-2 text-stone-600">{slide.spec}</span>
							</span>
							<button
								type="button"
								data-open-modal={slide.id}
								tabindex={index === 0 ? 0 : -1}
								class="hero-slide-btn event-btn-pop cursor-pointer py-2 font-medium text-stone-300 transition hover:text-white"
							>
								Ver detalles <span aria-hidden="true">↗</span>
							</button>
						</figcaption>
					</figure>
				))}
			</div>
		</div>
	</div>

	<!-- Open benchmark branches with a restrained scroll timeline. -->
	<section id="skills-timeline-section" class="mx-auto max-w-5xl scroll-mt-24">
		<header class="mb-8 max-w-2xl space-y-3 sm:mb-10">
			<p class="text-[11px] font-semibold uppercase tracking-[.16em] text-[#ff5500]">Tecnología en detalle</p>
			<h2 class="text-2xl font-semibold tracking-tight text-white sm:text-3xl">Rendimiento que se nota.</h2>
			<p class="text-sm leading-relaxed text-stone-400">Conoce la potencia, los materiales y los detalles detrás de cada equipo.</p>
		</header>
		<div class="relative" data-skills-tree>
			<div class="pointer-events-none absolute bottom-3 left-3 top-3 w-px -translate-x-1/2 bg-white/10 sm:left-1/2" aria-hidden="true">
				<div id="skills-timeline-progress" class="h-full w-full origin-top bg-[#ff5500]/70"></div>
			</div>
			<div class="space-y-10 sm:space-y-14">
				{skills.map((skill, index) => (
					<article class="skill-timeline-item relative grid pl-12 sm:grid-cols-2 sm:gap-16 sm:pl-0">
						<span class="skill-timeline-dot absolute left-3 top-0 z-10 flex h-6 w-6 -translate-x-1/2 items-center justify-center rounded-full border border-white/20 bg-[#08080b] text-[10px] font-medium text-stone-400 sm:left-1/2" aria-hidden="true">{index + 1}</span>
						<span class:list={['absolute left-3 top-3 h-px w-6 bg-white/15 sm:left-1/2 sm:w-8', { 'sm:-translate-x-full': index % 2 === 0 }]} aria-hidden="true"></span>
						<div class:list={['skill-branch space-y-3', { 'sm:col-start-2': index % 2 !== 0 }]}>
							<p class="text-xs font-medium text-[#ff5500]">{skill.category}</p>
							<h3 class="text-lg font-semibold tracking-tight text-white">{skill.title}</h3>
							<p class="text-sm leading-relaxed text-stone-400">{skill.desc}</p>
							<p class="text-xs leading-relaxed text-stone-500">{skill.tags.join(' · ')}</p>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<!-- Seasonal offers with a single flat surface per combo -->
	<section id="section-temporada" class="scroll-mt-24 space-y-8">
		<div class="flex flex-wrap items-end justify-between gap-4">
			<div class="space-y-2">
				<p class="inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-[.16em] text-[#ff5500]">
					<Icon name="flame" class="h-3.5 w-3.5 text-[#ff5500]" />
					<span>Edición Limitada · Serie Black Titanium 2026</span>
				</p>
				<h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-white">
					Colección de temporada con bonificación directa
				</h2>
				<p class="max-w-2xl text-sm text-stone-400">
					Configuraciones insignia combinadas con accesorios de alta fidelidad y hasta $450 de ahorro.
				</p>
			</div>
			<p class="text-xs font-medium text-[#ff5500]">
				Evento oficial activo
			</p>
		</div>

		<div class="grid gap-x-10 gap-y-12 md:grid-cols-2">
			{seasonalOffers.map((offer) => (
				<SeasonalOfferCard offer={offer} />
			))}
		</div>
	</section>

	<!-- Featured products sharing the open ProductCard layout -->
	<section id="section-destacados" class="space-y-8">
		<div class="flex flex-wrap items-end justify-between gap-4">
			<div class="space-y-2">
				<p class="text-[11px] font-semibold uppercase tracking-[.16em] text-[#ff5500]">
					Selección de alta demanda
				</p>
				<h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-white">
					Equipos más solicitados por profesionales
				</h2>
			</div>
			<button
				type="button"
				data-tab-target="catalogo"
				class="event-btn-pop cursor-pointer py-2 text-xs font-medium text-stone-300 transition hover:text-white"
			>
				Ir al catálogo completo <span aria-hidden="true">→</span>
			</button>
		</div>

		<div class="grid gap-x-8 gap-y-10 md:grid-cols-3">
			{featuredProducts.map((product) => (
				<ProductCard product={product} context="featured" />
			))}
		</div>

		<PaymentBadges variant="hero" />
	</section>

	<!-- Open institutional history, statistics, milestones, and pillars -->
	<section id="section-nosotros" class="scroll-mt-24 space-y-14 border-t border-white/10 pt-16">
		<div class="max-w-3xl space-y-3">
			<p class="text-[11px] font-semibold uppercase tracking-[.16em] text-[#ff5500]">
				{storeInfo.about.badge}
			</p>
			<h2 class="text-2xl sm:text-3xl lg:text-4xl font-semibold tracking-tight text-white">
				{storeInfo.about.title}
			</h2>
			<p class="text-sm sm:text-base leading-relaxed text-stone-400">
				{storeInfo.about.lead}
			</p>
		</div>

		<div class="grid grid-cols-2 gap-6 border-y border-white/10 py-8 sm:grid-cols-4">
			{storeInfo.about.stats.map((st) => (
				<div class="space-y-1">
					<p class="text-2xl sm:text-3xl font-semibold tracking-tight text-white">{st.value}</p>
					<p class="text-xs text-stone-400">{st.label}</p>
				</div>
			))}
		</div>

		<div class="space-y-8">
			<div class="flex flex-wrap items-end justify-between gap-4">
				<div class="space-y-1">
					<h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-white">
						Cronología de innovación: nuestra trayectoria
					</h3>
					<p class="text-sm text-stone-400">
						Cuatro hitos que definieron nuestro estándar en hardware de precisión.
					</p>
				</div>
				<span class="text-xs font-medium text-stone-500">2021 — 2026</span>
			</div>

			<div id="nosotros-staircase" class="divide-y divide-white/10 border-t border-white/10">
				{storeInfo.about.milestones.map((milestone, idx) => {
					const stepIndentClass = idx === 0
						? 'lg:ml-0'
						: idx === 1
							? 'lg:ml-8'
							: idx === 2
								? 'lg:ml-16'
								: 'lg:ml-24';
					return (
						<article
							class={`staircase-step py-8 ${stepIndentClass}`}
							data-step-index={idx}
						>
							<div class="grid gap-6 lg:grid-cols-12 items-center">
								<div class="milestone-img-container lg:col-span-5 aspect-[16/10] overflow-hidden rounded-2xl bg-[#0a0a0e]">
									<img
										src={milestone.image}
										alt={milestone.title}
										loading="lazy"
										class="milestone-parallax-img h-full w-full object-cover will-change-transform"
									/>
								</div>

								<div class="lg:col-span-7 space-y-2.5">
									<p class="text-xs text-stone-400">
										<span class="font-medium text-[#ff5500]">Fase {milestone.step} · {milestone.year}</span>
										<span class="mx-2 text-stone-600">·</span>
										<span>{milestone.phase}</span>
										<span class="mx-2 text-stone-600">·</span>
										<span class="text-stone-500">{milestone.tag}</span>
									</p>
									<h4 class="text-lg sm:text-xl font-semibold tracking-tight text-white">
										{milestone.title}
									</h4>
									<p class="text-sm leading-relaxed text-stone-400">
										{milestone.description}
									</p>
								</div>
							</div>
						</article>
					);
				})}
			</div>
		</div>

		<div class="grid gap-8 border-t border-white/10 pt-10 sm:grid-cols-3">
			{storeInfo.about.pillars.map((pil, idx) => (
				<div class="space-y-2">
					<div class="flex items-center gap-2 text-sm font-semibold text-white">
						<span class="text-[#ff5500]">
							<Icon name={idx === 0 ? 'shield' : idx === 1 ? 'truck' : 'headset'} class="h-4 w-4" />
						</span>
						<span>{pil.title}</span>
					</div>
					<p class="text-xs sm:text-sm leading-relaxed text-stone-400">{pil.desc}</p>
				</div>
			))}
		</div>
	</section>

	<!-- Lightweight trust and warranty blocks -->
	<div class="grid gap-8 border-y border-white/10 py-10 sm:grid-cols-2 lg:grid-cols-4">
		<div class="benefit-card space-y-2">
			<div class="flex items-center gap-2 text-sm font-semibold text-white">
				<span class="text-[#ff5500]"><Icon name="truck" class="h-4 w-4" /></span>
				<span>Envío Express Asegurado</span>
			</div>
			<p class="text-xs sm:text-sm leading-relaxed text-stone-400">
				Entrega en 24h a domicilio con póliza de seguro de transporte contra pérdidas o daños.
			</p>
		</div>

		<div class="benefit-card space-y-2">
			<div class="flex items-center gap-2 text-sm font-semibold text-white">
				<span class="text-[#ff5500]"><Icon name="lock" class="h-4 w-4" /></span>
				<span>Pasarela Encriptada 256-bit</span>
			</div>
			<p class="text-xs sm:text-sm leading-relaxed text-stone-400">
				Aceptamos tarjetas de crédito sin intereses, transferencias inmediatas y códigos QR.
			</p>
		</div>

		<div class="benefit-card space-y-2">
			<div class="flex items-center gap-2 text-sm font-semibold text-white">
				<span class="text-[#ff5500]"><Icon name="warranty" class="h-4 w-4" /></span>
				<span>Garantía Directa Oficial</span>
			</div>
			<p class="text-xs sm:text-sm leading-relaxed text-stone-400">
				Productos nuevos, precintados de fábrica con servicio técnico certificado y repuestos originales.
			</p>
		</div>

		<div class="benefit-card space-y-2">
			<div class="flex items-center gap-2 text-sm font-semibold text-white">
				<span class="text-[#ff5500]"><Icon name="headset" class="h-4 w-4" /></span>
				<span>Asesoría Técnica 1 a 1</span>
			</div>
			<p class="text-xs sm:text-sm leading-relaxed text-stone-400">
				Especialistas en hardware disponibles en tiempo real para resolver dudas de compatibilidad.
			</p>
		</div>
	</div>

	<!-- Open contact section without nested outer/inner cards -->
	<section id="section-contacto" class="scroll-mt-24">
		<div class="grid gap-10 lg:grid-cols-12 items-start">
			<div class="lg:col-span-6 space-y-5">
				<div class="space-y-2">
					<p class="text-[11px] font-semibold uppercase tracking-[.16em] text-[#ff5500]">
						Atención inmediata
					</p>
					<h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-white">
						Contacto directo y showroom presencial
					</h2>
					<p class="text-sm leading-relaxed text-stone-400">
						¿Tienes requerimientos especiales de configuración o compras corporativas? Nuestro equipo de ingenieros de hardware está a tu disposición en nuestro espacio de San Borja.
					</p>
				</div>

				<div class="space-y-3 pt-1 text-xs sm:text-sm text-stone-300">
					<div class="flex items-center gap-3">
						<Icon name="pin" class="h-4 w-4 shrink-0 text-[#ff5500]" />
						<span>{storeInfo.contact.address}</span>
					</div>
					<div class="flex items-center gap-3">
						<Icon name="phone" class="h-4 w-4 shrink-0 text-[#ff5500]" />
						<span>Central telefónica: <strong class="font-medium text-white">{storeInfo.contact.phone}</strong></span>
					</div>
					<div class="flex items-center gap-3">
						<Icon name="whatsapp" class="h-4 w-4 shrink-0 text-[#ff5500]" />
						<span>WhatsApp oficial: <strong class="font-medium text-white">{storeInfo.contact.whatsapp}</strong></span>
					</div>
					<div class="flex items-center gap-3">
						<Icon name="clock" class="h-4 w-4 shrink-0 text-[#ff5500]" />
						<span>Horario showroom: {storeInfo.contact.hours}</span>
					</div>
				</div>
			</div>

			<div class="lg:col-span-6 space-y-4">
				<h3 class="text-base font-semibold text-white">
					Solicita asesoría técnica con un ingeniero
				</h3>
				<div class="space-y-3">
					<div>
						<label for="contact-name" class="block text-xs font-medium text-stone-400 mb-1.5">Nombre completo</label>
						<input
							id="contact-name"
							name="contact_name"
							type="text"
							autocomplete="name"
							placeholder="Tu nombre completo"
							class="w-full rounded-xl border border-white/15 bg-[#0a0a0e] px-3.5 py-2.5 text-sm text-white placeholder-stone-500 transition focus:border-[#ff5500] focus:outline-none"
						/>
					</div>
					<div>
						<label for="contact-email" class="block text-xs font-medium text-stone-400 mb-1.5">Correo electrónico</label>
						<input
							id="contact-email"
							name="contact_email"
							type="email"
							autocomplete="email"
							placeholder="correo@empresa.com"
							class="w-full rounded-xl border border-white/15 bg-[#0a0a0e] px-3.5 py-2.5 text-sm text-white placeholder-stone-500 transition focus:border-[#ff5500] focus:outline-none"
						/>
					</div>
					<div>
						<label for="contact-message" class="block text-xs font-medium text-stone-400 mb-1.5">Requerimiento técnico</label>
						<textarea
							id="contact-message"
							name="contact_message"
							rows="3"
							placeholder="¿Qué equipo o requerimiento estás buscando?"
							class="w-full rounded-xl border border-white/15 bg-[#0a0a0e] px-3.5 py-2.5 text-sm text-white placeholder-stone-500 transition focus:border-[#ff5500] focus:outline-none"
						></textarea>
					</div>
					<button
						type="button"
						onclick="alert('¡Gracias! Un especialista en hardware te responderá en menos de 15 minutos.')"
						class="event-btn-pop w-full cursor-pointer rounded-full bg-white py-3 text-xs font-semibold text-black transition hover:bg-stone-200"
					>
						Enviar consulta a soporte especializado <span aria-hidden="true">→</span>
					</button>
				</div>
			</div>
		</div>
	</section>
</section>
