---
import PaymentBadges from './PaymentBadges.astro';
---

<section id="tab-checkout" class="tab-panel hidden mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 space-y-10">
	<!-- Open header for checkout -->
	<header class="flex flex-wrap items-end justify-between gap-6 border-b border-white/10 pb-7">
		<div class="space-y-2.5">
			<p class="text-[11px] font-semibold uppercase tracking-[.18em] text-[#ff5500]">
				Checkout encriptado SSL 256-bit · Garantía oficial directa
			</p>
			<h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-white">
				Pasarela de pago y resumen de compra
			</h2>
			<p class="text-sm leading-relaxed text-stone-400">
				Revisa tus equipos seleccionados, aplica un cupón de descuento y confirma tu orden.
			</p>
		</div>

		<button
			type="button"
			data-tab-target="catalogo"
			class="event-btn-pop inline-flex cursor-pointer items-center gap-2 rounded-full border border-white/10 bg-white/[0.02] px-4 py-2.5 text-xs font-medium text-stone-300 transition hover:border-white/25 hover:text-white"
		>
			<span aria-hidden="true">←</span> Seguir explorando catálogo
		</button>
	</header>

	<div class="grid gap-8 lg:grid-cols-12 lg:gap-10 items-start">
		<!-- Left column: Symmetric checkout steps -->
		<div class="lg:col-span-7">
			<form id="checkout-form" class="space-y-8">
				<!-- Step 1: Buyer and delivery details -->
				<section aria-labelledby="checkout-step-1-heading" class="surface-card p-6 sm:p-8 space-y-7">
					<div class="flex flex-wrap items-center justify-between gap-3 border-b border-white/10 pb-5">
						<div class="flex items-center gap-3.5">
							<span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-white/20 bg-white/[0.03] text-xs font-semibold text-stone-200">1</span>
							<h3 id="checkout-step-1-heading" class="text-base sm:text-lg font-semibold tracking-tight text-white">
								Datos de despacho y facturación
							</h3>
						</div>
						<span class="text-[11px] font-medium text-stone-500">Despacho express asegurado</span>
					</div>

					<div class="grid gap-5 sm:grid-cols-2 sm:gap-6">
						<div class="space-y-2">
							<label for="buyer-name" class="block text-xs font-medium tracking-wide text-stone-300">Nombre completo *</label>
							<input
								type="text"
								required
								id="buyer-name"
								name="buyer_name"
								autocomplete="name"
								placeholder="Ej. Carlos Mendoza"
								value="Carlos Mendoza"
								class="w-full rounded-xl border border-white/12 bg-[#050507] px-4 py-3 text-sm text-white placeholder-stone-500 transition focus:border-[#ff5500] focus:outline-none"
							/>
						</div>
						<div class="space-y-2">
							<label for="buyer-email" class="block text-xs font-medium tracking-wide text-stone-300">Correo electrónico *</label>
							<input
								type="email"
								required
								id="buyer-email"
								name="buyer_email"
								autocomplete="email"
								autocorrect="off"
								autocapitalize="off"
								spellcheck="false"
								placeholder="carlos@empresa.com"
								value="carlos@electronova.pe"
								class="w-full rounded-xl border border-white/12 bg-[#050507] px-4 py-3 text-sm text-white placeholder-stone-500 transition focus:border-[#ff5500] focus:outline-none"
							/>
						</div>
						<div class="space-y-2">
							<label for="buyer-phone" class="block text-xs font-medium tracking-wide text-stone-300">Teléfono / WhatsApp *</label>
							<input
								type="tel"
								required
								id="buyer-phone"
								name="buyer_phone"
								autocomplete="tel"
								placeholder="+51 999 888 777"
								value="+51 987 654 321"
								class="w-full rounded-xl border border-white/12 bg-[#050507] px-4 py-3 text-sm text-white placeholder-stone-500 transition focus:border-[#ff5500] focus:outline-none"
							/>
						</div>
						<div class="space-y-2">
							<label for="buyer-invoice-type" class="block text-xs font-medium tracking-wide text-stone-300">Tipo de comprobante</label>
							<select
								id="buyer-invoice-type"
								name="invoice_type"
								class="w-full rounded-xl border border-white/12 bg-[#050507] px-4 py-3 text-sm text-white transition focus:border-[#ff5500] focus:outline-none"
							>
								<option value="boleta">Boleta Electrónica (DNI)</option>
								<option value="factura">Factura Electrónica (RUC 20)</option>
							</select>
						</div>
						<div class="sm:col-span-2 space-y-2">
							<label for="buyer-address" class="block text-xs font-medium tracking-wide text-stone-300">Dirección de entrega en Lima / Provincias *</label>
							<input
								type="text"
								required
								id="buyer-address"
								name="buyer_address"
								autocomplete="street-address"
								placeholder="Av. Javier Prado Este 2450, San Borja, Lima"
								value="Av. Javier Prado Este 2450, San Borja, Lima"
								class="w-full rounded-xl border border-white/12 bg-[#050507] px-4 py-3 text-sm text-white placeholder-stone-500 transition focus:border-[#ff5500] focus:outline-none"
							/>
						</div>
					</div>
				</section>

				<!-- Step 2: Payment method selection and panels -->
				<section aria-labelledby="checkout-step-2-heading" class="surface-card p-6 sm:p-8 space-y-7">
					<div class="flex flex-wrap items-center justify-between gap-3 border-b border-white/10 pb-5">
						<div class="flex items-center gap-3.5">
							<span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-[#ff5500] bg-[#ff5500]/10 text-xs font-semibold text-[#ff5500]">2</span>
							<h3 id="checkout-step-2-heading" class="text-base sm:text-lg font-semibold tracking-tight text-white">
								Selecciona tu método de pago
							</h3>
						</div>
						<span class="text-[11px] font-mono text-stone-500">TLS 1.3 · 3D Secure</span>
					</div>

					<div class="grid grid-cols-1 sm:grid-cols-3 gap-3" role="group" aria-label="Método de pago">
						<button
							type="button"
							data-pay-method="card"
							aria-pressed="true"
							class="pay-method-btn is-active cursor-pointer rounded-xl px-4 py-3.5 text-center text-xs font-semibold"
						>
							Tarjeta Crédito / Débito
						</button>
						<button
							type="button"
							data-pay-method="qr"
							aria-pressed="false"
							class="pay-method-btn cursor-pointer rounded-xl px-4 py-3.5 text-center text-xs font-medium"
						>
							Yape / Plin QR
						</button>
						<button
							type="button"
							data-pay-method="transfer"
							aria-pressed="false"
							class="pay-method-btn cursor-pointer rounded-xl px-4 py-3.5 text-center text-xs font-medium"
						>
							Transferencia CIP
						</button>
					</div>

					<!-- Panel 1: Credit/Debit card -->
					<div id="pay-panel-card" class="pay-panel space-y-7">
						<div class="metallic-gold-card mx-auto max-w-md rounded-2xl border border-white/12 bg-gradient-to-br from-[#12121a] via-[#0b0b10] to-[#060609] p-6 sm:p-7 text-white shadow-xl">
							<div class="flex items-center justify-between text-xs">
								<span class="font-medium uppercase tracking-[0.14em] text-stone-400">ElectroNova Titanium</span>
								<span id="card-brand-label" class="font-mono font-semibold text-white">VISA / MC</span>
							</div>
							<p id="card-preview-number" class="my-6 font-mono text-lg sm:text-xl tracking-[0.2em] text-white font-semibold">
								4539 •••• •••• 8842
							</p>
							<div class="flex items-end justify-between gap-4 text-xs pt-1 border-t border-white/8">
								<div class="space-y-1 pt-3">
									<span class="block text-[10px] uppercase tracking-wider text-stone-500">Titular</span>
									<span id="card-preview-holder" class="block font-medium tracking-wider uppercase text-stone-200">CARLOS MENDOZA</span>
								</div>
								<div class="space-y-1 pt-3 text-right">
									<span class="block text-[10px] uppercase tracking-wider text-stone-500">Expira</span>
									<span id="card-preview-expiry" class="block font-mono font-medium text-stone-200">09/29</span>
								</div>
							</div>
						</div>

						<div class="grid gap-5 sm:grid-cols-2 sm:gap-6">
							<div class="sm:col-span-2 space-y-2">
								<label for="input-card-number" class="block text-xs font-medium tracking-wide text-stone-300">Número de tarjeta</label>
								<input
									type="text"
									id="input-card-number"
									name="cc-number"
									autocomplete="cc-number"
									inputmode="numeric"
									maxlength="19"
									placeholder="4539 1488 2039 8842"
									value="4539 1488 2039 8842"
									class="w-full rounded-xl border border-white/12 bg-[#050507] px-4 py-3 font-mono text-sm text-white transition focus:border-[#ff5500] focus:outline-none"
								/>
							</div>
							<div class="space-y-2">
								<label for="input-card-holder" class="block text-xs font-medium tracking-wide text-stone-300">Nombre en la tarjeta</label>
								<input
									type="text"
									id="input-card-holder"
									name="cc-name"
									autocomplete="cc-name"
									placeholder="CARLOS MENDOZA"
									value="CARLOS MENDOZA"
									class="w-full rounded-xl border border-white/12 bg-[#050507] px-4 py-3 text-sm uppercase text-white transition focus:border-[#ff5500] focus:outline-none"
								/>
							</div>
							<div class="grid grid-cols-2 gap-4">
								<div class="space-y-2">
									<label for="input-card-expiry" class="block text-xs font-medium tracking-wide text-stone-300">Vencimiento (MM/AA)</label>
									<input
										type="text"
										id="input-card-expiry"
										name="cc-exp"
										autocomplete="cc-exp"
										inputmode="numeric"
										maxlength="5"
										placeholder="09/29"
										value="09/29"
										class="w-full rounded-xl border border-white/12 bg-[#050507] px-3.5 py-3 font-mono text-sm text-white transition focus:border-[#ff5500] focus:outline-none"
									/>
								</div>
								<div class="space-y-2">
									<label for="input-card-cvv" class="block text-xs font-medium tracking-wide text-stone-300">Código CVV</label>
									<input
										type="text"
										id="input-card-cvv"
										name="cc-csc"
										autocomplete="cc-csc"
										inputmode="numeric"
										maxlength="4"
										placeholder="849"
										value="849"
										class="w-full rounded-xl border border-white/12 bg-[#050507] px-3.5 py-3 font-mono text-sm text-white transition focus:border-[#ff5500] focus:outline-none"
									/>
								</div>
							</div>
							<div class="sm:col-span-2 space-y-2">
								<label for="input-card-installments" class="block text-xs font-medium tracking-wide text-stone-300">Plan de cuotas sin intereses</label>
								<select
									id="input-card-installments"
									name="installments"
									class="w-full rounded-xl border border-white/12 bg-[#050507] px-4 py-3 text-sm text-white transition focus:border-[#ff5500] focus:outline-none"
								>
									<option value="1">Pago directo (1 cuota sin intereses)</option>
									<option value="3">3 cuotas sin intereses (0% TCEA)</option>
									<option value="6">6 cuotas sin intereses (0% TCEA)</option>
									<option value="12">12 cuotas sin intereses BBVA / BCP / Interbank</option>
								</select>
							</div>
						</div>
					</div>

					<!-- Panel 2: QR Payment (Yape / Plin) -->
					<div id="pay-panel-qr" class="pay-panel hidden space-y-5 border-t border-white/10 pt-6 text-center">
						<p class="text-sm font-medium text-white">Escanea el código QR desde Yape, Plin o tu banca móvil</p>
						<div class="mx-auto flex h-44 w-44 items-center justify-center rounded-2xl bg-white p-3.5 shadow-lg">
							<svg aria-hidden="true" viewBox="0 0 100 100" class="h-full w-full text-black" fill="currentColor">
								<rect x="5" y="5" width="28" height="28" fill="none" stroke="currentColor" stroke-width="6" />
								<rect x="13" y="13" width="12" height="12" />
								<rect x="67" y="5" width="28" height="28" fill="none" stroke="currentColor" stroke-width="6" />
								<rect x="75" y="13" width="12" height="12" />
								<rect x="5" y="67" width="28" height="28" fill="none" stroke="currentColor" stroke-width="6" />
								<rect x="13" y="75" width="12" height="12" />
								<rect x="42" y="10" width="8" height="8" />
								<rect x="42" y="26" width="16" height="8" />
								<rect x="42" y="42" width="16" height="16" />
								<rect x="10" y="42" width="20" height="8" />
								<rect x="66" y="42" width="24" height="8" />
								<rect x="42" y="66" width="10" height="24" />
								<rect x="62" y="62" width="14" height="14" />
								<rect x="82" y="76" width="12" height="18" />
							</svg>
						</div>
						<p class="text-xs text-stone-400">A nombre de: <strong class="font-medium text-white">ELECTRONOVA HARDWARE LABS S.A.C.</strong></p>
						<div class="mx-auto max-w-xs space-y-2">
							<label for="input-qr-code" class="block text-xs font-medium tracking-wide text-stone-300">Código de aprobación (6 dígitos)</label>
							<input
								type="text"
								id="input-qr-code"
								inputmode="numeric"
								maxlength="6"
								placeholder="Ej. 482910"
								value="482910"
								class="w-full rounded-xl border border-white/12 bg-[#050507] px-4 py-3 text-center font-mono text-sm text-white transition focus:border-[#ff5500] focus:outline-none"
							/>
						</div>
					</div>

					<!-- Panel 3: Bank Transfer / CIP -->
					<div id="pay-panel-transfer" class="pay-panel hidden space-y-4 border-t border-white/10 pt-6">
						<div class="flex items-center justify-between rounded-xl border border-white/10 bg-[#050507] px-4 py-3.5">
							<span class="text-xs text-stone-400">Código CIP PagoEfectivo:</span>
							<span class="font-mono text-base font-semibold text-[#ff5500]">928-441-092</span>
						</div>
						<p class="text-xs sm:text-sm text-stone-400 leading-relaxed">
							Puedes abonar este código desde la aplicación de BCP, BBVA, Interbank o Scotiabank. Tu reserva de stock se mantiene garantizada por 12 horas.
						</p>
					</div>

					<div class="space-y-6 border-t border-white/10 pt-6">
						<PaymentBadges variant="checkout" />

						<button
							type="submit"
							id="submit-payment-btn"
							class="event-btn-pop w-full cursor-pointer flex items-center justify-center gap-2.5 rounded-full bg-white px-6 py-4 text-sm font-semibold text-black transition hover:bg-stone-200"
						>
							<svg aria-hidden="true" class="h-4 w-4 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
							</svg>
							<span>Confirmar y procesar orden</span>
						</button>
					</div>
				</section>
			</form>
		</div>

		<!-- Right column: Sticky order summary with symmetric surface padding -->
		<aside class="lg:col-span-5">
			<div class="surface-card sticky top-24 p-6 sm:p-8 space-y-6">
				<div class="flex items-center justify-between border-b border-white/10 pb-5">
					<h3 class="text-base sm:text-lg font-semibold tracking-tight text-white">Resumen de tu bolsa</h3>
					<button
						type="button"
						id="clear-cart-btn"
						class="cursor-pointer text-xs font-medium text-stone-400 transition hover:text-rose-400"
					>
						Vaciar bolsa
					</button>
				</div>

				<div id="checkout-cart-items" class="max-h-80 divide-y divide-white/10 overflow-y-auto pr-1"></div>

				<div id="checkout-empty-state" class="hidden py-8 text-center space-y-4">
					<p class="text-sm text-stone-400">Tu bolsa aún no tiene equipos seleccionados.</p>
					<div class="flex flex-wrap justify-center gap-3">
						<button
							type="button"
							data-tab-target="catalogo"
							class="event-btn-pop cursor-pointer rounded-full bg-white px-4 py-2.5 text-xs font-semibold text-black transition hover:bg-stone-200"
						>
							Ir al catálogo
						</button>
						<button
							type="button"
							id="load-demo-cart-btn"
							class="event-btn-pop cursor-pointer rounded-full border border-white/20 px-4 py-2.5 text-xs font-medium text-stone-300 transition hover:border-white/40 hover:text-white"
						>
							Cargar equipos demo
						</button>
					</div>
				</div>

				<div class="space-y-3.5 border-t border-white/10 pt-5">
					<div class="flex flex-wrap items-center justify-between gap-2 text-xs">
						<label for="coupon-input" class="font-medium tracking-wide text-stone-300">
							Cupón de descuento
						</label>
						<div class="flex flex-wrap items-center gap-2 text-[11px] text-stone-400">
							<button
								type="button"
								data-coupon-quick="NOVA2026"
								class="cursor-pointer font-mono hover:text-white transition"
							>
								NOVA2026
							</button>
							<span aria-hidden="true">·</span>
							<button
								type="button"
								data-coupon-quick="TECH10"
								class="cursor-pointer font-mono hover:text-white transition"
							>
								TECH10
							</button>
							<span aria-hidden="true">·</span>
							<button
								type="button"
								data-coupon-quick="TITANIUM10"
								class="cursor-pointer font-mono hover:text-white transition"
							>
								TITANIUM10
							</button>
							<span aria-hidden="true">·</span>
							<button
								type="button"
								data-coupon-quick="DESPACHO"
								class="cursor-pointer font-mono hover:text-white transition"
							>
								DESPACHO
							</button>
						</div>
					</div>

					<div class="flex gap-2.5">
						<input
							type="text"
							id="coupon-input"
							autocorrect="off"
							autocapitalize="off"
							spellcheck="false"
							placeholder="Ingresa código..."
							class="flex-1 rounded-xl border border-white/12 bg-[#050507] px-3.5 py-2.5 text-xs uppercase text-white placeholder-stone-500 transition focus:border-[#ff5500] focus:outline-none"
						/>
						<button
							type="button"
							id="apply-coupon-btn"
							class="event-btn-pop cursor-pointer rounded-xl border border-white/20 px-4 py-2.5 text-xs font-medium text-white transition hover:border-white/40"
						>
							Aplicar
						</button>
					</div>
					<p id="coupon-feedback" class="hidden text-xs" role="status" aria-live="polite"></p>
				</div>

				<div class="space-y-3 border-t border-white/10 pt-5 text-xs sm:text-sm">
					<div class="flex justify-between text-stone-400">
						<span>Subtotal equipos</span>
						<span id="summary-subtotal" class="font-medium text-white">$0.00</span>
					</div>
					<div class="flex justify-between text-stone-400">
						<span>Descuento aplicado</span>
						<span id="summary-discount" class="font-medium text-[#ff5500]">-$0.00</span>
					</div>
					<div class="flex justify-between text-stone-400">
						<span>Envío express asegurado</span>
						<span class="font-medium text-stone-200">Gratis</span>
					</div>
					<div class="flex justify-between items-baseline border-t border-white/10 pt-4 text-base font-semibold text-white">
						<span>Total a pagar</span>
						<span id="summary-total" class="text-xl font-semibold text-white">$0.00</span>
					</div>
				</div>
			</div>
		</aside>
	</div>

	<!-- Payment confirmation modal with a single clean surface -->
	<div
		id="payment-success-modal"
		class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/80"
	>
		<div
			id="payment-success-card"
			role="dialog"
			aria-modal="true"
			aria-labelledby="payment-success-title"
			class="surface-card w-full max-w-md p-7 text-center space-y-5"
		>
			<div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full border border-[#ff5500]/40 text-[#ff5500]">
				<svg aria-hidden="true" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
				</svg>
			</div>
			<div class="space-y-1.5">
				<h3 id="payment-success-title" class="text-xl font-semibold text-white">Orden registrada con éxito</h3>
				<p class="text-xs leading-relaxed text-stone-400">
					Tu pedido de hardware oficial ha sido verificado y programado para despacho prioritario.
				</p>
			</div>

			<div class="divide-y divide-white/10 border-y border-white/10 py-2 text-left text-xs">
				<div class="flex justify-between py-2">
					<span class="text-stone-400">N° de orden</span>
					<span id="receipt-order-id" class="font-mono font-medium text-[#ff5500]">#EN-2026-8941</span>
				</div>
				<div class="flex justify-between py-2">
					<span class="text-stone-400">Cliente titular</span>
					<span id="receipt-buyer" class="font-medium text-white">Carlos Mendoza</span>
				</div>
				<div class="flex justify-between py-2">
					<span class="text-stone-400">Importe total pagado</span>
					<span id="receipt-total" class="font-semibold text-white">$0.00</span>
				</div>
			</div>

			<button
