---
import PaymentBadges from './PaymentBadges.astro';
---

<!-- Modal de Información Detallada de cada Card -->
<div
	id="product-info-modal"
	class="fixed inset-0 z-50 hidden items-center justify-center p-4 sm:p-6"
	aria-hidden="true"
>
	<!-- Fondo oscuro con desenfoque de estudio BandWerk -->
	<div id="modal-backdrop" class="fixed inset-0 bg-black/85 backdrop-blur-md"></div>

	<!-- Contenedor del Modal con Curvatura de 2rem y Acabado Realista -->
	<div
		id="modal-dialog"
		class="card-2rem relative z-10 max-h-[92vh] w-full max-w-4xl overflow-y-auto rounded-[2rem] p-6 sm:p-9 shadow-2xl border border-white/15 bg-[#0d0d12]"
	>
		<!-- Botón Cerrar -->
		<button
			type="button"
			id="modal-close-btn"
			class="event-btn-pop cursor-pointer absolute top-5 right-5 flex h-10 w-10 items-center justify-center rounded-full border border-white/20 bg-white/10 text-stone-300 transition hover:border-[#ff5500] hover:text-[#ff5500]"
			aria-label="Cerrar información del producto"
		>
			<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
				<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
			</svg>
		</button>

		<div class="grid gap-8 lg:grid-cols-12">
			<!-- Columna Izquierda: Imagen y Garantía -->
			<div class="lg:col-span-5 space-y-4">
				<div class="relative overflow-hidden rounded-[1.5rem] border border-white/15 bg-black aspect-square">
					<img
						id="modal-img"
						src="/images/laptop-pro.png"
						alt="Producto"
						class="h-full w-full object-cover"
					/>
					<span
						id="modal-badge"
						class="absolute top-3 left-3 rounded-full bg-[#ff5500] px-3 py-1 text-xs font-black text-white shadow-md"
					>
						Destacado
					</span>
				</div>

				<!-- Puntos Clave / Highlights con Estilo BandWerk -->
				<div class="rounded-2xl border border-white/10 bg-black/60 p-4">
					<h4 class="text-xs font-black uppercase tracking-wider text-[#ff5500]">Puntos Destacados de Laboratorio</h4>
					<ul id="modal-highlights" class="mt-2.5 space-y-2 text-xs text-stone-300"></ul>
				</div>

				<!-- Garantía -->
				<div class="flex items-center gap-3 rounded-2xl border border-white/15 bg-white/5 p-3.5 text-xs text-white">
					<span class="text-[#ff5500]">
						<svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
						</svg>
					</span>
					<span id="modal-warranty" class="font-bold"></span>
				</div>

				<!-- Medios de Pago en el Modal -->
				<div class="pt-1">
					<PaymentBadges variant="card" />
				</div>
			</div>

			<!-- Columna Derecha: Info Completa y Ficha Técnica -->
			<div class="lg:col-span-7 flex flex-col justify-between space-y-6">
				<div>
					<div class="flex flex-wrap items-center gap-2 text-xs">
						<span id="modal-category" class="rounded-lg bg-white/10 px-2.5 py-1 font-black text-white border border-white/20 uppercase tracking-wider"></span>
						<span id="modal-sku" class="font-mono text-stone-400"></span>
						<span id="modal-rating" class="ml-auto font-bold text-[#ff5500] mr-8"></span>
					</div>

					<h3 id="modal-title" class="mt-3 text-2xl sm:text-3xl font-black text-white"></h3>

					<div class="mt-3 flex items-baseline gap-3">
						<span id="modal-price" class="text-3xl font-black text-white"></span>
						<span id="modal-old-price" class="text-sm text-stone-500 line-through"></span>
						<span id="modal-stock" class="ml-auto rounded-lg bg-white/10 border border-white/20 px-2.5 py-1 text-xs font-bold text-white"></span>
					</div>

					<p id="modal-description" class="mt-4 text-sm text-stone-300 leading-relaxed"></p>

					<!-- Tabla de Especificaciones Técnicas -->
					<div class="mt-6">
						<h4 class="text-xs font-black uppercase tracking-wider text-white mb-3">
							Ficha Técnica de Calibración
						</h4>
						<div id="modal-specs" class="divide-y divide-white/10 rounded-2xl border border-white/10 bg-black/60 overflow-hidden"></div>
					</div>
				</div>

				<!-- Acciones de Compra desde el Modal -->
				<div class="flex flex-wrap items-center gap-3 border-t border-white/10 pt-5">
					<button
						type="button"
						id="modal-add-cart-btn"
						class="event-btn-pop cursor-pointer flex-1 rounded-2xl border border-white/20 bg-white/5 px-5 py-3.5 text-sm font-black text-white transition hover:border-[#ff5500] hover:text-[#ff5500]"
					>
						+ Añadir a la Bolsa
					</button>
					<button
						type="button"
						id="modal-buy-now-btn"
						class="event-btn-pop cursor-pointer flex-1 rounded-2xl bg-white text-black hover:bg-stone-200 px-5 py-3.5 text-sm font-black shadow-lg hover:brightness-105 active:scale-95 transition"
					>
						Comprar Ahora &rarr;
					</button>
				</div>
			</div>
		</div>
	</div>
</div>
