---
import PaymentBadges from './PaymentBadges.astro';
---

<!-- Full-screen product detail view without changing the browser URL -->
<div
	id="product-info-modal"
	data-lenis-prevent
	class="fixed inset-0 z-50 hidden overflow-y-auto overscroll-contain"
	aria-hidden="true"
>
	<div id="modal-backdrop" class="fixed inset-0 bg-black/80 backdrop-blur-xs" aria-hidden="true"></div>

	<div
		id="modal-dialog"
		role="dialog"
		aria-modal="true"
		aria-labelledby="modal-title"
		class="relative z-10 min-h-screen w-full bg-[#050507] text-white will-change-transform"
	>
		<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-12 space-y-10">
			<!-- Top navigation bar for the product screen -->
			<header class="flex flex-wrap items-center justify-between gap-4 border-b border-white/10 pb-5">
				<button
					type="button"
					id="modal-close-btn"
					class="event-btn-pop inline-flex cursor-pointer items-center gap-2 py-1.5 text-xs sm:text-sm font-medium text-stone-300 transition hover:text-white"
					aria-label="Volver a la vista anterior"
				>
					<span aria-hidden="true">←</span>
					<span>Volver</span>
				</button>

				<div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-xs text-stone-400">
					<span id="modal-category" class="font-medium text-stone-200"></span>
					<span aria-hidden="true">·</span>
					<span id="modal-badge" class="font-medium text-[#ff5500]"></span>
					<span aria-hidden="true">·</span>
					<span id="modal-sku" class="font-mono text-stone-500"></span>
				</div>
			</header>

			<!-- Main two-column open product layout -->
			<div class="grid gap-10 lg:grid-cols-12 lg:gap-14 items-start">
				<!-- Left column: Large product image, warranty, and payment methods -->
				<div class="lg:col-span-6 space-y-6">
					<div class="aspect-[4/3] sm:aspect-square overflow-hidden rounded-2xl bg-[#0a0a0e]">
						<img
							id="modal-img"
							src="/images/laptop-pro.png"
							alt="Producto"
							class="h-full w-full object-cover"
						/>
					</div>

					<div class="flex items-start gap-2.5 border-t border-white/10 pt-5 text-xs sm:text-sm text-stone-300">
						<svg aria-hidden="true" class="mt-0.5 h-4 w-4 shrink-0 text-[#ff5500]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
						</svg>
						<span id="modal-warranty" class="leading-relaxed"></span>
					</div>

					<div class="border-t border-white/10 pt-4">
						<PaymentBadges variant="hero" />
					</div>
				</div>

				<!-- Right column: Editorial details, actions, highlights, and technical specifications -->
				<div class="lg:col-span-6 space-y-8">
					<div class="space-y-4">
						<div class="flex flex-wrap items-center justify-between gap-2 text-xs text-stone-400">
							<span id="modal-rating" class="font-medium text-stone-300"></span>
							<span id="modal-stock" class="text-stone-400"></span>
						</div>

						<h2 id="modal-title" class="text-3xl sm:text-4xl font-semibold tracking-tight text-white"></h2>

						<div class="flex flex-wrap items-baseline gap-3 pt-1">
							<span id="modal-price" class="text-3xl sm:text-4xl font-semibold text-white"></span>
							<span id="modal-old-price" class="text-sm text-stone-500 line-through"></span>
						</div>

						<p id="modal-description" class="pt-1 text-sm sm:text-base leading-relaxed text-stone-400"></p>
					</div>

					<div class="flex flex-wrap items-center gap-3 border-y border-white/10 py-6">
						<button
							type="button"
							id="modal-add-cart-btn"
							class="event-btn-pop flex-1 cursor-pointer rounded-full border border-white/20 bg-transparent px-6 py-3.5 text-xs sm:text-sm font-semibold text-white transition hover:border-white/40"
						>
							Añadir a la bolsa
						</button>
						<button
							type="button"
							id="modal-buy-now-btn"
							class="event-btn-pop flex-1 cursor-pointer rounded-full bg-white px-6 py-3.5 text-xs sm:text-sm font-semibold text-black transition hover:bg-stone-200"
						>
							Comprar ahora <span aria-hidden="true">→</span>
						</button>
					</div>

					<div class="space-y-3">
						<h3 class="text-xs font-semibold uppercase tracking-wider text-stone-300">
							Puntos destacados
						</h3>
						<ul id="modal-highlights" class="space-y-2 text-xs sm:text-sm leading-relaxed text-stone-400"></ul>
					</div>

					<div class="space-y-3 pt-2">
						<h3 class="text-xs font-semibold uppercase tracking-wider text-stone-300">
							Ficha técnica
						</h3>
						<div id="modal-specs" class="divide-y divide-white/10 border-y border-white/10"></div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
