---
import type { Product } from '../data/products';

interface Props {
	product: Product;
	context: 'featured' | 'catalog';
}

const { product, context } = Astro.props;
const isCatalog = context === 'catalog';
const normalizedSearch = isCatalog
	? `${product.name} ${product.shortDesc} ${product.description} ${product.category}`.toLowerCase()
	: undefined;
---

<article
	data-card-category={isCatalog ? product.category : undefined}
	data-card-name={normalizedSearch}
	class:list={[
		isCatalog ? 'catalog-card' : 'featured-card',
		'group flex flex-col justify-between gap-4 border-b border-white/10 pb-6',
	]}
>
	<div class="space-y-3">
		<div class="relative aspect-[4/3] overflow-hidden rounded-2xl bg-[#0a0a0e]">
			<img
				src={product.image}
				alt={product.name}
				loading="lazy"
				class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.02]"
			/>
		</div>

		<div class="flex flex-wrap items-center justify-between gap-2 text-xs text-stone-400">
			<span>
				<span class="font-medium text-stone-300">{product.category}</span>
				{product.badge && (
					<span class="ml-1.5 text-[#ff5500]">· {product.badge}</span>
				)}
			</span>
			<span>
				★ {product.rating} ({product.reviews}) · {product.stock} disp.
			</span>
		</div>

		<div class="space-y-1.5">
			<h3 class="text-lg sm:text-[19px] font-semibold tracking-tight text-white">
				{product.name}
			</h3>
			<p class="text-[13px] sm:text-sm leading-relaxed text-stone-400 line-clamp-2">
				{product.shortDesc}
			</p>
		</div>
	</div>

	<div class="flex flex-wrap items-end justify-between gap-3 pt-2">
		<div class="flex items-baseline gap-2">
			<span class="text-xl font-semibold text-white">${product.price.toLocaleString()}</span>
			{product.oldPrice && (
				<span class="text-xs text-stone-500 line-through">${product.oldPrice.toLocaleString()}</span>
			)}
		</div>

		<div class="flex items-center gap-3">
			<button
				type="button"
				data-open-modal={product.id}
				aria-label={`Ver ficha de ${product.name}`}
				class="event-btn-pop cursor-pointer py-2 text-xs font-medium text-stone-300 transition hover:text-white"
			>
				Ver ficha <span aria-hidden="true">↗</span>
			</button>
			<button
				type="button"
				data-add-cart={product.id}
				aria-label={`Añadir ${product.name} al carrito`}
				class="event-btn-pop cursor-pointer rounded-full bg-white px-4 py-2 text-xs font-semibold text-black transition hover:bg-stone-200"
			>
				Añadir
			</button>
		</div>
	</div>
</article>
