---
interface Props {
	variant?: 'hero' | 'card' | 'checkout';
	showInstallments?: boolean;
}

const { variant = 'hero', showInstallments = true } = Astro.props;
---

<div
	class:list={[
		'flex flex-wrap items-center justify-between gap-x-6 gap-y-2 text-xs leading-relaxed text-stone-400',
		variant === 'card' && 'pt-2 text-[11px]',
		variant === 'checkout' && 'py-1',
	]}
>
	<p class="flex flex-wrap items-center gap-x-2.5 gap-y-1.5">
		<span class="font-medium text-stone-300">Medios de pago:</span>
		<span>Visa</span>
		<span aria-hidden="true">·</span>
		<span>Mastercard</span>
		<span aria-hidden="true">·</span>
		<span>Amex</span>
		<span aria-hidden="true">·</span>
		<span>Apple Pay</span>
		<span aria-hidden="true">·</span>
		<span>Google Pay</span>
		<span aria-hidden="true">·</span>
		<span>Yape / Plin</span>
		<span aria-hidden="true">·</span>
		<span>CIP Bancario</span>
	</p>
	{showInstallments && (
		<span class="text-stone-400">Hasta 12 cuotas sin interés · SSL 256-bit</span>
	)}
</div>
