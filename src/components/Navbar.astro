---
---

<header class="sticky top-0 z-40 border-b border-white/10 bg-[#060608]/90 backdrop-blur-xl">
	<div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3.5 sm:px-6 lg:px-8">
		<!-- Logo Realista con Fondo Transparente -->
		<button
			type="button"
			data-nav-target="landing"
			class="event-btn-pop flex items-center gap-2 focus:outline-none cursor-pointer"
			aria-label="Ir al inicio de ElectroNova Showroom"
		>
			<img
				src="/images/logo-electronova.svg"
				alt="ElectroNova Hardware Labs"
				class="h-9 sm:h-10 w-auto object-contain transition-transform duration-300 hover:scale-[1.02]"
			/>
		</button>

		<!-- Menú de Navegación Estilo BandWerk (Negro, Blanco y Acentos Naranja) -->
		<nav
			aria-label="Navegación principal de la tienda"
			class="hidden md:flex items-center gap-1 rounded-[1.5rem] border border-white/10 bg-[#0e0e12]/90 p-1.5 shadow-inner"
		>
			<!-- Pestaña 1: Showroom -->
			<button
				type="button"
				data-tab-target="landing"
				class="nav-tab-btn active-tab event-btn-pop cursor-pointer flex items-center gap-1.5 rounded-2xl px-4 py-1.5 text-xs font-bold transition-all duration-200 bg-white text-black shadow-md"
			>
				<span>Showroom</span>
			</button>

			<!-- Pestaña 2: Catálogo -->
			<button
				type="button"
				data-tab-target="catalogo"
				class="nav-tab-btn event-btn-pop cursor-pointer flex items-center gap-1.5 rounded-2xl px-4 py-1.5 text-xs font-bold text-stone-300 hover:text-white hover:bg-white/10 transition-all duration-200"
			>
				<span>Catálogo</span>
			</button>

			<!-- Mini-Pestaña 3: Temporada -->
			<button
				type="button"
				data-scroll-anchor="section-temporada"
				class="mini-nav-btn event-btn-pop cursor-pointer flex items-center gap-1.5 rounded-2xl px-3.5 py-1.5 text-xs font-semibold text-stone-300 hover:text-[#ff5500] hover:bg-white/5 transition-all duration-200"
			>
				<span class="h-1.5 w-1.5 rounded-full bg-[#ff5500] animate-pulse"></span>
				<span>Temporada 2026</span>
				<span class="rounded bg-[#ff5500]/20 px-1.5 py-0.2 text-[9px] font-black text-[#ff5500] uppercase tracking-wider">Edición</span>
			</button>

			<!-- Mini-Pestaña 4: Nosotros -->
			<button
				type="button"
				data-scroll-anchor="section-nosotros"
				class="mini-nav-btn event-btn-pop cursor-pointer flex items-center gap-1.5 rounded-2xl px-3.5 py-1.5 text-xs font-semibold text-stone-300 hover:text-white hover:bg-white/5 transition-all duration-200"
			>
				<span>Nosotros</span>
			</button>

			<!-- Mini-Pestaña 5: Contacto -->
			<button
				type="button"
				data-scroll-anchor="section-contacto"
				class="mini-nav-btn event-btn-pop cursor-pointer flex items-center gap-1.5 rounded-2xl px-3.5 py-1.5 text-xs font-semibold text-stone-300 hover:text-white hover:bg-white/5 transition-all duration-200"
			>
				<span>Contacto</span>
			</button>
		</nav>

		<!-- Botón de Carrito Realista con Badge Naranja BandWerk -->
		<div class="flex items-center gap-2">
			<!-- Mini links rápidos en mobile -->
			<div class="flex md:hidden items-center gap-1">
				<button
					type="button"
					data-tab-target="catalogo"
					class="event-btn-pop rounded-xl border border-white/10 bg-[#121216] px-2.5 py-1.5 text-xs font-bold text-white"
				>
					Catálogo
				</button>
				<button
					type="button"
					data-scroll-anchor="section-temporada"
					class="event-btn-pop rounded-xl border border-[#ff5500]/30 bg-[#ff5500]/10 px-2 py-1.5 text-[11px] font-bold text-[#ff5500]"
				>
					Temporada
				</button>
			</div>

			<button
				type="button"
				id="nav-cart-trigger"
				data-tab-target="checkout"
				class="event-btn-pop cursor-pointer group flex items-center gap-2.5 sm:gap-3 rounded-[1.5rem] border border-white/15 bg-[#121218]/90 px-3.5 sm:px-4 py-2 text-xs font-medium text-white transition hover:border-[#ff5500]/70 hover:bg-[#1a1a22] shadow-md"
				title="Iniciar proceso de compra"
			>
				<div class="relative flex h-8 w-8 items-center justify-center rounded-xl bg-white/10 text-white group-hover:bg-[#ff5500] group-hover:text-white transition">
					<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
					</svg>
					<span
						id="nav-cart-badge"
						class="absolute -top-1 -right-1 inline-flex h-4 min-w-[16px] items-center justify-center rounded-full bg-[#ff5500] px-1 text-[10px] font-black text-white shadow-sm transition-transform"
					>
						2
					</span>
				</div>
				<div class="text-left hidden sm:block">
					<span class="block text-[9px] text-stone-400 uppercase tracking-wider font-bold">Bolsa</span>
					<span id="nav-cart-total" class="font-black text-white">$2,248</span>
				</div>
				<span class="hidden lg:inline-block rounded-lg bg-[#ff5500]/20 px-2 py-1 text-[10px] font-black text-[#ff5500] border border-[#ff5500]/30 group-hover:bg-[#ff5500] group-hover:text-white transition">
					Pagar &rarr;
				</span>
			</button>
		</div>
	</div>
</header>
