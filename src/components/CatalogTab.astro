---
import { products } from '../data/products';
import ProductCard from './ProductCard.astro';
import PaymentBadges from './PaymentBadges.astro';

const categories = ['Todos', 'Laptops', 'Smartphones', 'Audio', 'Wearables', 'Gaming', 'Drones'];
---

<section id="tab-catalogo" class="tab-panel hidden mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 space-y-10">
	<header class="space-y-6 border-b border-white/10 pb-6">
		<div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
			<div class="space-y-2">
				<p class="text-[11px] font-semibold uppercase tracking-[.16em] text-[#ff5500]">
					Catálogo Oficial 2026
				</p>
				<h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-white">
					Equipos calibrados para profesionales
				</h2>
				<p class="text-sm text-stone-400">
					Explora especificaciones completas seleccionando <span class="text-stone-200 font-medium">Ver ficha</span> en cada equipo.
				</p>
			</div>

			<div class="relative w-full lg:w-80">
				<label for="catalog-search" class="sr-only">Buscar equipos en el catálogo</label>
				<input
					id="catalog-search"
					type="search"
					autocorrect="off"
					autocapitalize="off"
					spellcheck="false"
					placeholder="Buscar laptop, titanio, drone, OLED..."
					class="w-full rounded-xl border border-white/15 bg-[#0a0a0e] py-2.5 pl-10 pr-4 text-sm text-white placeholder-stone-500 transition focus:border-[#ff5500] focus:outline-none"
				/>
				<svg aria-hidden="true" class="pointer-events-none absolute left-3.5 top-3 h-4 w-4 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
				</svg>
			</div>
		</div>

		<div class="flex flex-wrap items-center justify-between gap-4 pt-1">
			<div class="flex flex-wrap items-center gap-x-5 gap-y-2" id="category-filters" role="group" aria-label="Filtrar por categoría">
				{categories.map((cat, idx) => (
					<button
						type="button"
						data-filter-cat={cat}
						aria-pressed={idx === 0 ? 'true' : 'false'}
						class:list={['cat-filter-btn cursor-pointer', { 'is-active': idx === 0 }]}
					>
						{cat}
					</button>
				))}
			</div>

			<p class="text-xs text-stone-400">
				Mostrando <strong id="catalog-count" class="font-semibold text-white">{products.length}</strong> equipos certificados
			</p>
		</div>
	</header>

	<div id="catalog-grid" class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
		{products.map((product) => (
			<ProductCard product={product} context="catalog" />
		))}
	</div>

	<div class="border-t border-white/10 pt-6">
		<PaymentBadges variant="hero" />
	</div>
</section>
