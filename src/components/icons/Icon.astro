---
interface Props {
	name: string;
	class?: string;
	size?: number | string;
}

const { name, class: className = 'h-5 w-5', size } = Astro.props;
const dimensionProps = size ? { width: size, height: size } : {};
---

{name === 'laptop' && (
	<svg class={className} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" {...dimensionProps}>
		<path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
	</svg>
)}

{name === 'smartphone' && (
	<svg class={className} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" {...dimensionProps}>
		<rect x="7" y="2" width="10" height="20" rx="3" stroke-linecap="round" stroke-linejoin="round" />
		<path stroke-linecap="round" stroke-linejoin="round" d="M11 5h2m-1 13h.01" />
	</svg>
)}

{name === 'audio' && (
	<svg class={className} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" {...dimensionProps}>
